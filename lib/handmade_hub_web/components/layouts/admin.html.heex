<!-- ========== HEADER ========== -->
<% ad = assigns[:current_admin] %>
<header class="sticky top-0 z-50 w-full bg-white/95 backdrop-blur-sm border-b border-gray-200 shadow-sm">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo -->
      <div class="flex items-center">
        <.link href={~p"/admin/dashboard"} class="flex items-center space-x-3 group">
          <div class="w-10 h-10 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-xl flex items-center justify-center shadow-lg group-hover:shadow-xl transition-shadow">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2z" />
            </svg>
          </div>
          <span class="text-xl font-bold text-gray-900">
            Handmade<span class="text-indigo-600">Hub</span>
            <span class="hidden sm:inline text-gray-400">Admin</span>
          </span>
        </.link>
      </div>

      <!-- Right Section: Admin avatar dropdown -->
      <div class="flex items-center space-x-4">
        <div class="relative" x-data="{ open: false }">
          <button 
            id="admin-menu-button"
            type="button"
            class="flex items-center space-x-3 text-sm rounded-full focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
            aria-haspopup="menu"
            aria-expanded="false"
            aria-label="Admin menu"
            @click="open = !open"
            @click.outside="open = false"
            @keydown.escape.window="open = false"
          >
            <span class="hidden md:block text-sm font-medium text-gray-700">
              <%= ad && (ad.username || String.split(ad.email, "@") |> List.first()) %>
            </span>
            <div class="relative">
              <%= if ad && ad.profile_image do %>
                <img class="h-8 w-8 rounded-full object-cover ring-2 ring-white" src={ad.profile_image} alt="Admin Avatar" />
              <% else %>
                <div class="h-8 w-8 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-semibold text-sm shadow-md">
                  <%= ad && String.first(ad.username || ad.email) |> String.upcase() %>
                </div>
              <% end %>
              <span class="absolute bottom-0 right-0 block h-2.5 w-2.5 rounded-full bg-green-400 ring-2 ring-white"></span>
            </div>
          </button>

          <!-- Dropdown Menu -->
          <div
            class="absolute right-0 mt-2 w-56 rounded-lg shadow-lg bg-white ring-1 ring-black ring-opacity-5 divide-y divide-gray-100"
            role="menu"
            aria-orientation="vertical"
            aria-labelledby="admin-menu-button"
            x-show="open"
            x-transition.opacity
            style="display: none;"
          >
            <div class="px-4 py-3">
              <p class="text-sm text-gray-500">Signed in as</p>
              <p class="text-sm font-medium text-gray-900 truncate"><%= ad && ad.email %></p>
            </div>
            <div class="py-1">
              <.link href={~p"/admin/dashboard"} class="group flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900" role="menuitem">Dashboard</.link>
              <.link href={~p"/admin/settings"} class="group flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900" role="menuitem">Settings</.link>
              <.link href={~p"/browse"} class="group flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900" role="menuitem">Browse</.link>
            </div>
            <div class="py-1">
              <.link href={~p"/admin/log_out"} method="delete" class="group flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900" role="menuitem">Sign out</.link>
            </div>
          </div>
        </div>
      </div>
    </div>
  </nav>
  <!-- You can add a mobile menu here if needed -->
  
</header>
<!-- ========== END HEADER ========== -->

 

<div class="flex min-h-[calc(100vh-7rem)] bg-gradient-to-br from-gray-100 to-gray-200">
  <aside id="admin-sidebar" class="bg-white/95 backdrop-blur-sm border-r border-slate-200/60 flex-shrink-0 transition-all duration-300 ease-in-out shadow-lg hidden md:block w-72">
    <div class="h-full flex flex-col">
      <div class="p-6 border-b border-slate-100/80">
        <div class="flex items-center justify-between">
          <div class="flex items-center">
            <div class="w-10 h-10 bg-gradient-to-br from-blue-600 to-purple-600 rounded-xl flex items-center justify-center shadow-lg">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
              </svg>
            </div>
            <div class="ml-3">
              <h2 class="text-xl font-bold bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">Admin Hub</h2>
              <p class="text-xs text-slate-500 mt-0.5">Operations Dashboard</p>
            </div>
          </div>
          <button id="admin-sidebar-toggle" class="p-2 rounded-lg hover:bg-slate-100 transition-colors duration-200 text-slate-400 hover:text-slate-600" aria-label="Toggle sidebar">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
        </div>
      </div>

      <nav class="flex-1 p-4">
        <% current_path = @current_admin_path || "" %>
        <div class="space-y-2">
          <.link navigate={~p"/admin/dashboard"} class={[
            "w-full flex items-center px-4 py-3 rounded-xl transition-all duration-200 group",
            String.starts_with?(current_path, "/admin/dashboard") && "bg-blue-50 text-blue-600 shadow-sm" || "text-slate-600 hover:bg-slate-50 hover:text-slate-900"
          ]}>
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5a2 2 0 012-2h4a2 2 0 012 2v6a2 2 0 01-2 2H10a2 2 0 01-2-2V5z" /></svg>
            <span class="ml-3 font-medium js-collapsible-label">Dashboard</span>
            <div class={["ml-auto w-2 h-2 bg-blue-500 rounded-full opacity-0 group-hover:opacity-100 transition-opacity js-collapsible-label", String.starts_with?(current_path, "/admin/dashboard") && "opacity-100"]}></div>
          </.link>
          <.link navigate={~p"/admin/artisans"} class={[
            "w-full flex items-center px-4 py-3 rounded-xl transition-all duration-200 group",
            String.starts_with?(current_path, "/admin/artisans") && "bg-blue-50 text-blue-600 shadow-sm" || "text-slate-600 hover:bg-slate-50 hover:text-slate-900"
          ]}>
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
            <span class="ml-3 font-medium js-collapsible-label">Artisans</span>
            <div class={["ml-auto w-2 h-2 bg-blue-500 rounded-full opacity-0 group-hover:opacity-100 transition-opacity js-collapsible-label", String.starts_with?(current_path, "/admin/artisans") && "opacity-100"]}></div>
          </.link>
          <.link navigate={~p"/admin/buyers"} class={[
            "w-full flex items-center px-4 py-3 rounded-xl transition-all duration-200 group",
            String.starts_with?(current_path, "/admin/buyers") && "bg-blue-50 text-blue-600 shadow-sm" || "text-slate-600 hover:bg-slate-50 hover:text-slate-900"
          ]}>
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z"/></svg>
            <span class="ml-3 font-medium js-collapsible-label">Buyers</span>
            <div class={["ml-auto w-2 h-2 bg-blue-500 rounded-full opacity-0 group-hover:opacity-100 transition-opacity js-collapsible-label", String.starts_with?(current_path, "/admin/buyers") && "opacity-100"]}></div>
          </.link>
          <.link navigate={~p"/admin/products"} class={[
            "w-full flex items-center px-4 py-3 rounded-xl transition-all duration-200 group",
            String.starts_with?(current_path, "/admin/products") && "bg-blue-50 text-blue-600 shadow-sm" || "text-slate-600 hover:bg-slate-50 hover:text-slate-900"
          ]}>
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
            <span class="ml-3 font-medium js-collapsible-label">Products</span>
            <div class={["ml-auto w-2 h-2 bg-blue-500 rounded-full opacity-0 group-hover:opacity-100 transition-opacity js-collapsible-label", String.starts_with?(current_path, "/admin/products") && "opacity-100"]}></div>
          </.link>
          <.link navigate={~p"/admin/orders"} class={[
            "w-full flex items-center px-4 py-3 rounded-xl transition-all duration-200 group",
            String.starts_with?(current_path, "/admin/orders") && "bg-blue-50 text-blue-600 shadow-sm" || "text-slate-600 hover:bg-slate-50 hover:text-slate-900"
          ]}>
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
            <span class="ml-3 font-medium js-collapsible-label">Orders</span>
            <div class={["ml-auto w-2 h-2 bg-blue-500 rounded-full opacity-0 group-hover:opacity-100 transition-opacity js-collapsible-label", String.starts_with?(current_path, "/admin/orders") && "opacity-100"]}></div>
          </.link>
          <.link navigate={~p"/admin/delivery/riders"} class={[
            "w-full flex items-center px-4 py-3 rounded-xl transition-all duration-200 group",
            String.starts_with?(current_path, "/admin/delivery") && "bg-blue-50 text-blue-600 shadow-sm" || "text-slate-600 hover:bg-slate-50 hover:text-slate-900"
          ]}>
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>
            <span class="ml-3 font-medium js-collapsible-label">Delivery Riders</span>
            <div class={["ml-auto w-2 h-2 bg-blue-500 rounded-full opacity-0 group-hover:opacity-100 transition-opacity js-collapsible-label", String.starts_with?(current_path, "/admin/delivery") && "opacity-100"]}></div>
          </.link>
          <.link navigate={~p"/admin/reviews"} class={[
            "w-full flex items-center px-4 py-3 rounded-xl transition-all duration-200 group",
            String.starts_with?(current_path, "/admin/reviews") && "bg-blue-50 text-blue-600 shadow-sm" || "text-slate-600 hover:bg-slate-50 hover:text-slate-900"
          ]}>
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
            <span class="ml-3 font-medium js-collapsible-label">Reviews</span>
            <div class={["ml-auto w-2 h-2 bg-blue-500 rounded-full opacity-0 group-hover:opacity-100 transition-opacity js-collapsible-label", String.starts_with?(current_path, "/admin/reviews") && "opacity-100"]}></div>
          </.link>
          <.link navigate={~p"/admin/analytics"} class={[
            "w-full flex items-center px-4 py-3 rounded-xl transition-all duration-200 group",
            String.starts_with?(current_path, "/admin/analytics") && "bg-blue-50 text-blue-600 shadow-sm" || "text-slate-600 hover:bg-slate-50 hover:text-slate-900"
          ]}>
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.983 13.9a1.9 1.9 0 100-3.8 1.9 1.9 0 000 3.8z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.285 12.972a7.953 7.953 0 000-1.944l2.122-1.55a.5.5 0 00.12-.66l-2-3.464a.5.5 0 00-.607-.218l-2.5 1a7.97 7.97 0 00-1.683-.98l-.375-2.65a.5.5 0 00-.497-.426h-4a.5.5 0 00-.497.426l-.375 2.65c.593-.23 1.157-.57 1.683-.98l2.5 1a.5.5 0 00.607-.218l2-3.464a.5.5 0 00-.12-.66l-2.122-1.55z"/></svg>
            <span class="ml-3 font-medium js-collapsible-label">Analytics</span>
            <div class={["ml-auto w-2 h-2 bg-blue-500 rounded-full opacity-0 group-hover:opacity-100 transition-opacity js-collapsible-label", String.starts_with?(current_path, "/admin/analytics") && "opacity-100"]}></div>
          </.link>

          <!-- Payment Management Section -->
          <div class="pt-4 mt-4 border-t border-slate-200/60">
            <h4 class="px-4 text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2 js-collapsible-label">
              Payment Management
            </h4>
          </div>
          
          <.link navigate={~p"/admin/transactions"} class={[
            "w-full flex items-center px-4 py-3 rounded-xl transition-all duration-200 group",
            String.starts_with?(current_path, "/admin/transactions") && "bg-emerald-50 text-emerald-600 shadow-sm" || "text-slate-600 hover:bg-slate-50 hover:text-slate-900"
          ]}>
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
            <span class="ml-3 font-medium js-collapsible-label">Transactions</span>
            <div class={["ml-auto w-2 h-2 bg-emerald-500 rounded-full opacity-0 group-hover:opacity-100 transition-opacity js-collapsible-label", String.starts_with?(current_path, "/admin/transactions") && "opacity-100"]}></div>
          </.link>
          
          <.link navigate={~p"/admin/payouts"} class={[
            "w-full flex items-center px-4 py-3 rounded-xl transition-all duration-200 group",
            String.starts_with?(current_path, "/admin/payouts") && "bg-emerald-50 text-emerald-600 shadow-sm" || "text-slate-600 hover:bg-slate-50 hover:text-slate-900"
          ]}>
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
            <span class="ml-3 font-medium js-collapsible-label">Payouts</span>
            <div class={["ml-auto w-2 h-2 bg-emerald-500 rounded-full opacity-0 group-hover:opacity-100 transition-opacity js-collapsible-label", String.starts_with?(current_path, "/admin/payouts") && "opacity-100"]}></div>
          </.link>

          <%= if ad && ad.role == "super_admin" do %>
            <.link navigate={~p"/admin/payment-settings"} class={[
              "w-full flex items-center px-4 py-3 rounded-xl transition-all duration-200 group",
              String.starts_with?(current_path, "/admin/payment-settings") && "bg-emerald-50 text-emerald-600 shadow-sm" || "text-slate-600 hover:bg-slate-50 hover:text-slate-900"
            ]}>
              <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <span class="ml-3 font-medium js-collapsible-label">Payment Settings</span>
              <div class={["ml-auto w-2 h-2 bg-emerald-500 rounded-full opacity-0 group-hover:opacity-100 transition-opacity js-collapsible-label", String.starts_with?(current_path, "/admin/payment-settings") && "opacity-100"]}></div>
            </.link>
          <% end %>

          <!-- System Section -->
          <div class="pt-4 mt-4 border-t border-slate-200/60">
            <h4 class="px-4 text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2 js-collapsible-label">
              System
            </h4>
          </div>

          <%= if ad && ad.role == "super_admin" do %>
            <.link navigate={~p"/admin/admins"} class={[
              "w-full flex items-center px-4 py-3 rounded-xl transition-all duration-200 group",
              String.starts_with?(current_path, "/admin/admins") && "bg-blue-50 text-blue-600 shadow-sm" || "text-slate-600 hover:bg-slate-50 hover:text-slate-900"
            ]}>
              <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
              <span class="ml-3 font-medium js-collapsible-label">Admin Management</span>
              <div class={["ml-auto w-2 h-2 bg-blue-500 rounded-full opacity-0 group-hover:opacity-100 transition-opacity js-collapsible-label", String.starts_with?(current_path, "/admin/admins") && "opacity-100"]}></div>
            </.link>
          <% end %>
          <.link navigate={~p"/admin/settings"} class={[
            "w-full flex items-center px-4 py-3 rounded-xl transition-all duration-200 group",
            String.starts_with?(current_path, "/admin/settings") && "bg-blue-50 text-blue-600 shadow-sm" || "text-slate-600 hover:bg-slate-50 hover:text-slate-900"
          ]}>
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.983 13.9a1.9 1.9 0 100-3.8 1.9 1.9 0 000 3.8z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.285 12.972a7.953 7.953 0 000-1.944l2.122-1.55a.5.5 0 00.12-.66l-2-3.464a.5.5 0 00-.607-.218l-2.5 1a7.97 7.97 0 00-1.683-.98l-.375-2.65a.5.5 0 00-.497-.426h-4a.5.5 0 00-.497.426l-.375 2.65c.593-.23 1.157-.57 1.683-.98l2.5 1a.5.5 0 00.607-.218l2-3.464a.5.5 0 00-.12-.66l-2.122-1.55z"/></svg>
            <span class="ml-3 font-medium js-collapsible-label">Settings</span>
            <div class={["ml-auto w-2 h-2 bg-blue-500 rounded-full opacity-0 group-hover:opacity-100 transition-opacity js-collapsible-label", String.starts_with?(current_path, "/admin/settings") && "opacity-100"]}></div>
          </.link>
        </div>
      </nav>

      <div class="p-4 border-t border-slate-100/80">
        <.link href={~p"/admin/log_out"} method="delete" class="w-full flex items-center px-4 py-3 rounded-xl transition-all duration-200 group text-red-600 hover:bg-red-50">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
          <span class="ml-3 font-medium js-collapsible-label">Logout</span>
        </.link>
      </div>
    </div>
  </aside>

  <div class="md:hidden">
    <button id="admin-mobile-toggle" class="fixed top-4 left-4 z-50 p-2 rounded-lg bg-white shadow-lg border border-slate-200">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </div>

  <main class="flex-1 overflow-hidden">
    <div class="p-6 h-full overflow-y-auto">
      <.flash_group flash={@flash} />
      <%= @inner_content %>
    </div>
  </main>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var aside = document.getElementById('admin-sidebar');
    var toggle = document.getElementById('admin-sidebar-toggle');
    var mobileToggle = document.getElementById('admin-mobile-toggle');
    var labels = document.querySelectorAll('#admin-sidebar .js-collapsible-label');
    try {
      var collapsed = localStorage.getItem('adminSidebarCollapsed') === 'true';
      if (collapsed) {
        aside.classList.remove('w-72');
        aside.classList.add('w-20');
        labels.forEach(function(el){ el.classList.add('hidden'); });
      }
      if (toggle) {
        toggle.addEventListener('click', function() {
          var isCollapsed = aside.classList.contains('w-20');
          if (isCollapsed) {
            aside.classList.remove('w-20');
            aside.classList.add('w-72');
            labels.forEach(function(el){ el.classList.remove('hidden'); });
            localStorage.setItem('adminSidebarCollapsed', 'false');
          } else {
            aside.classList.remove('w-72');
            aside.classList.add('w-20');
            labels.forEach(function(el){ el.classList.add('hidden'); });
            localStorage.setItem('adminSidebarCollapsed', 'true');
          }
        });
      }
      if (mobileToggle) {
        mobileToggle.addEventListener('click', function() {
          if (aside.classList.contains('hidden')) {
            aside.classList.remove('hidden');
          } else {
            aside.classList.add('hidden');
          }
        });
      }
    } catch (e) {}
  });
</script>


