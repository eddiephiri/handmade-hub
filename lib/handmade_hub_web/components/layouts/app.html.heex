<!-- ========== HEADER ========== -->
<% cu = assigns[:current_user] %>
<% ad = assigns[:current_admin] %>
<header class="sticky top-0 z-50 w-full bg-white/95 backdrop-blur-sm border-b border-gray-200 shadow-sm">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <!-- Logo -->
      <div class="flex items-center">
        <a href={~p"/"} class="flex items-center space-x-3 group">
          <div class="w-10 h-10 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-xl flex items-center justify-center shadow-lg group-hover:shadow-xl transition-shadow">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <span class="text-xl font-bold text-gray-900">
            Handmade<span class="text-indigo-600">Hub</span>
          </span>
        </a>
      </div>

      <!-- Center Navigation -->
      <div class="hidden md:flex items-center space-x-1">
        <.link 
          href={~p"/browse"} 
          class="px-4 py-2 rounded-lg text-sm font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-100 transition-colors"
        >
          Browse
        </.link>
        
        <%= if cu && cu.role == "artisan" && cu.artisan_status == "approved" do %>
          <.link 
            href={~p"/products/new"} 
            class="px-4 py-2 rounded-lg text-sm font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-100 transition-colors"
          >
            Sell
          </.link>
        <% end %>
        
        <.link 
          href={~p"/cart"} 
          class="px-4 py-2 rounded-lg text-sm font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-100 transition-colors flex items-center"
        >
          <svg class="w-5 h-5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
          Cart
        </.link>
      </div>

      <!-- Right Section -->
      <div class="flex items-center space-x-4">
        <%= if ad do %>
          <!-- Admin Dropdown -->
          <div class="relative" x-data="{ open: false }">
            <button 
              id="admin-menu-button" 
              type="button" 
              class="flex items-center space-x-3 text-sm rounded-full focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
              aria-haspopup="menu" 
              aria-expanded="false" 
              aria-label="Admin menu"
              @click="open = !open"
              @click.outside="open = false"
              @keydown.escape.window="open = false"
            >
              <span class="hidden md:block text-sm font-medium text-gray-700">
                <%= ad.username || String.split(ad.email, "@") |> List.first() %>
              </span>
              <div class="relative">
                <%= if ad.profile_image do %>
                  <img 
                    class="h-8 w-8 rounded-full object-cover ring-2 ring-white" 
                    src={ad.profile_image} 
                    alt="Admin Avatar"
                  />
                <% else %>
                  <div class="h-8 w-8 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-semibold text-sm shadow-md">
                    <%= String.first(ad.username || ad.email) |> String.upcase() %>
                  </div>
                <% end %>
                <span class="absolute bottom-0 right-0 block h-2.5 w-2.5 rounded-full bg-green-400 ring-2 ring-white"></span>
              </div>
            </button>
              
            <!-- Dropdown Menu -->
            <div 
              class="absolute right-0 mt-2 w-56 rounded-lg shadow-lg bg-white ring-1 ring-black ring-opacity-5 divide-y divide-gray-100" 
              role="menu" 
              aria-orientation="vertical" 
              aria-labelledby="admin-menu-button"
              x-show="open"
              x-transition.opacity
              style="display: none;"
            >
              <div class="px-4 py-3">
                <p class="text-sm text-gray-500">Signed in as</p>
                <p class="text-sm font-medium text-gray-900 truncate"><%= ad.email %></p>
              </div>
              <div class="py-1">
                <.link 
                  href={~p"/admin/dashboard"} 
                  class="group flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900"
                  role="menuitem"
                >
                  Dashboard
                </.link>
                <.link 
                  href={~p"/admin/settings"} 
                  class="group flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900"
                  role="menuitem"
                >
                  Settings
                </.link>
                <.link 
                  href={~p"/browse"} 
                  class="group flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900"
                  role="menuitem"
                >
                  Browse
                </.link>
              </div>
              <div class="py-1">
                <.link 
                  href={~p"/admin/log_out"} 
                  method="delete" 
                  class="group flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900"
                  role="menuitem"
                >
                  Sign out
                </.link>
              </div>
            </div>
          </div>
        <% else %>
        <%= if cu do %>
          <!-- User Dropdown (Alpine.js) -->
          <div class="relative" x-data="{ open: false }">
            <button 
              id="user-menu-button" 
              type="button" 
              class="flex items-center space-x-3 text-sm rounded-full focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500"
              aria-haspopup="menu" 
              aria-expanded="false" 
              aria-label="User menu"
              @click="open = !open"
              @click.outside="open = false"
              @keydown.escape.window="open = false"
            >
              <span class="hidden md:block text-sm font-medium text-gray-700">
                <%= cu.name || String.split(cu.email, "@") |> List.first() %>
              </span>
              <div class="relative">
                <%= if cu.profile_image do %>
                  <img 
                    class="h-8 w-8 rounded-full object-cover ring-2 ring-white" 
                    src={cu.profile_image} 
                    alt="Profile"
                  />
                <% else %>
                  <div class="h-8 w-8 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-semibold text-sm shadow-md">
                    <%= String.first(cu.name || cu.email) |> String.upcase() %>
                  </div>
                <% end %>
                <span class="absolute bottom-0 right-0 block h-2.5 w-2.5 rounded-full bg-green-400 ring-2 ring-white"></span>
              </div>
            </button>
              
            <!-- Dropdown Menu -->
            <div 
              class="absolute right-0 mt-2 w-56 rounded-lg shadow-lg bg-white ring-1 ring-black ring-opacity-5 divide-y divide-gray-100" 
              role="menu" 
              aria-orientation="vertical" 
              aria-labelledby="user-menu-button"
              x-show="open"
              x-transition.opacity
              style="display: none;"
            >
              <div class="px-4 py-3">
                <p class="text-sm text-gray-500">Signed in as</p>
                <p class="text-sm font-medium text-gray-900 truncate"><%= cu.email %></p>
              </div>
              
              <div class="py-1">
                <%= if cu.role == "artisan" && cu.artisan_status == "approved" do %>
                  <.link 
                    href={~p"/artisan/dashboard"} 
                    class="group flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900"
                    role="menuitem"
                  >
                    <svg class="mr-3 h-5 w-5 text-gray-400 group-hover:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" />
                    </svg>
                    Artisan Dashboard
                  </.link>
                <% else %>
                  <.link 
                    href={~p"/buyer/dashboard"} 
                    class="group flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900"
                    role="menuitem"
                  >
                    <svg class="mr-3 h-5 w-5 text-gray-400 group-hover:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                    </svg>
                    My Dashboard
                  </.link>
                <% end %>
                
                <.link 
                  href={~p"/orders"} 
                  class="group flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900"
                  role="menuitem"
                >
                  <svg class="mr-3 h-5 w-5 text-gray-400 group-hover:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                  </svg>
                  My Orders
                </.link>
              </div>
              
              <div class="py-1">
                <.link 
                  href={~p"/users/settings"} 
                  class="group flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900"
                  role="menuitem"
                >
                  <svg class="mr-3 h-5 w-5 text-gray-400 group-hover:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  Account Settings
                </.link>
              </div>
              
              <div class="py-1">
                <.link 
                  href={~p"/users/log_out"} 
                  method="delete" 
                  class="group flex items-center px-4 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900"
                  role="menuitem"
                >
                  <svg class="mr-3 h-5 w-5 text-gray-400 group-hover:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                  </svg>
                  Sign out
                </.link>
              </div>
            </div>
          </div>
        <% else %>
          <!-- Guest Navigation -->
          <div class="flex items-center space-x-3">
            <.link 
              href={~p"/users/log_in"} 
              class="px-4 py-2 text-sm font-medium text-gray-700 hover:text-gray-900 transition-colors"
            >
              Sign in
            </.link>
            <.link 
              href={~p"/users/register"} 
              class="px-4 py-2 bg-gradient-to-r from-indigo-600 to-purple-600 text-white text-sm font-medium rounded-lg hover:from-indigo-700 hover:to-purple-700 transition-all shadow-md hover:shadow-lg"
            >
              Get Started
            </.link>
          </div>
        <% end %>
        <% end %>
      </div>
      
      <!-- Mobile menu button -->
      <div class="md:hidden">
        <button 
          type="button" 
          class="p-2 rounded-lg text-gray-600 hover:text-gray-900 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-indigo-500"
          id="mobile-menu-button"
          aria-expanded="false"
        >
          <span class="sr-only">Open main menu</span>
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </nav>
  
  <!-- Mobile menu (hidden by default) -->
  <div class="md:hidden hidden" id="mobile-menu">
    <div class="px-2 pt-2 pb-3 space-y-1 bg-white border-t border-gray-200">
      <.link 
        href={~p"/browse"} 
        class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-50"
      >
        Browse
      </.link>
      
      <%= if cu do %>
        <%= if cu.role == "artisan" && cu.artisan_status == "approved" do %>
          <.link 
            href={~p"/products/new"} 
            class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-50"
          >
            Sell
          </.link>
          <.link 
            href={~p"/artisan/dashboard"} 
            class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-50"
          >
            Artisan Dashboard
          </.link>
        <% else %>
          <.link 
            href={~p"/buyer/dashboard"} 
            class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-50"
          >
            My Dashboard
          </.link>
        <% end %>
        
        <.link 
          href={~p"/cart"} 
          class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-50"
        >
          Cart
        </.link>
        
        <.link 
          href={~p"/orders"} 
          class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-50"
        >
          My Orders
        </.link>
        
        <.link 
          href={~p"/users/settings"} 
          class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-50"
        >
          Settings
        </.link>
        
        <.link 
          href={~p"/users/log_out"} 
          method="delete"
          class="block px-3 py-2 rounded-md text-base font-medium text-red-600 hover:text-red-700 hover:bg-red-50"
        >
          Sign out
        </.link>
      <% else %>
        <.link 
          href={~p"/users/log_in"} 
          class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-gray-900 hover:bg-gray-50"
        >
          Sign in
        </.link>
        <.link 
          href={~p"/users/register"} 
          class="block px-3 py-2 rounded-md text-base font-medium text-indigo-600 hover:text-indigo-700 hover:bg-indigo-50"
        >
          Get Started
        </.link>
      <% end %>
    </div>
  </div>
</header>
<!-- ========== END HEADER ========== -->

<!-- ========== BREADCRUMB AREA ========== -->
<%= if cu || ad do %>
  <%= if cu && cu.role == "artisan" && cu.artisan_status == "approved" && assigns[:show_artisan_sidebar] do %>
    <div class="w-full bg-gradient-to-r from-slate-50 to-gray-100 border-b border-gray-200 shadow-sm">
      <div class="flex">
        <!-- Sidebar space -->
        <div class="hidden md:block w-64 shrink-0"></div>
        <!-- Breadcrumb content area -->
        <div class="flex-1 px-4 sm:px-6 lg:px-8">
          <div class="flex justify-between items-center h-12">
            <!-- Breadcrumb Navigation -->
            <.breadcrumb items={[
              %{label: "Dashboard", href: ~p"/"},
              %{label: "Home", href: ~p"/"},
              %{label: "Dashboard", href: nil}
            ]} />
            
            <!-- Date and Time Display -->
            <div class="flex items-center">
              <.datetime_display />
            </div>
          </div>
        </div>
      </div>
    </div>
  <% else %>
    <%= if ad && assigns[:show_admin_sidebar] != false do %>
      <div class="w-full bg-gradient-to-r from-slate-50 to-gray-100 border-b border-gray-200 shadow-sm">
        <div class="flex">
          <!-- Sidebar space -->
          <div class="hidden md:block w-64 shrink-0"></div>
          <!-- Breadcrumb content area -->
          <div class="flex-1 px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-12">
              <!-- Breadcrumb Navigation -->
              <.breadcrumb items={[
                %{label: "Dashboard", href: ~p"/admin/dashboard"},
                %{label: "Home", href: ~p"/admin/dashboard"},
                %{label: "Dashboard", href: nil}
              ]} />
              
              <!-- Date and Time Display -->
              <div class="flex items-center">
                <.datetime_display />
              </div>
            </div>
          </div>
        </div>
      </div>
    <% else %>
      <div class="w-full bg-gradient-to-r from-slate-50 to-gray-100 border-b border-gray-200 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex justify-between items-center h-12">
            <!-- Breadcrumb Navigation -->
            <.breadcrumb items={[
              %{label: "Dashboard", href: ~p"/"},
              %{label: "Home", href: ~p"/"},
              %{label: "Dashboard", href: nil}
            ]} />
            
            <!-- Date and Time Display -->
            <div class="flex items-center">
              <.datetime_display />
            </div>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>
<!-- ========== END BREADCRUMB AREA ========== -->

<!-- ========== MAIN CONTENT ========== -->
<main class="min-h-screen bg-gradient-to-br from-gray-100 to-gray-200">
  <%= if cu && cu.role == "artisan" && cu.artisan_status == "approved" && assigns[:show_artisan_sidebar] do %>
    <div class="flex gap-6 px-4 sm:px-6 lg:px-8 py-6 items-stretch" style="min-height: calc(100vh - 112px)">
      <aside class="hidden md:block w-64 shrink-0" style="min-height: calc(100vh - 112px)">
        <nav class="bg-white border rounded-lg p-4 space-y-1" style="min-height: calc(100vh - 112px)">
          <.link href={~p"/artisan/dashboard"} class="block px-3 py-2 rounded hover:bg-gray-50">Dashboard</.link>
          <.link href={~p"/products"} class="block px-3 py-2 rounded hover:bg-gray-50">My Products</.link>
          <.link href={~p"/orders"} class="block px-3 py-2 rounded hover:bg-gray-50">Orders</.link>
          <.link href={~p"/messages?from=dashboard"} class="block px-3 py-2 rounded hover:bg-gray-50">Messages</.link>
          <.link href={~p"/users/settings?from=dashboard"} class="block px-3 py-2 rounded hover:bg-gray-50">Settings</.link>
          <div :if={!assigns[:hide_back_to_browse]} class="pt-2 mt-2 border-t">
            <.link href={~p"/browse"} class="block px-3 py-2 rounded hover:bg-gray-50">Back to Browse</.link>
          </div>
        </nav>
      </aside>
      <section class="flex-1">
        <.flash_group flash={@flash} />
        <%= @inner_content %>
      </section>
    </div>
  <% else %>
  <%= if ad && assigns[:show_admin_sidebar] != false do %>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex gap-6">
      <aside class="hidden md:block w-64 shrink-0">
        <nav class="bg-white border rounded-lg p-4 space-y-1 sticky top-20">
          <.link href={~p"/admin/dashboard"} class="block px-3 py-2 rounded hover:bg-gray-50">Dashboard</.link>
          <.link href={~p"/admin/artisans"} class="block px-3 py-2 rounded hover:bg-gray-50">Artisans</.link>
          <.link href={~p"/admin/buyers"} class="block px-3 py-2 rounded hover:bg-gray-50">Buyers</.link>
          <.link href={~p"/admin/products"} class="block px-3 py-2 rounded hover:bg-gray-50">Products</.link>
          <.link href={~p"/admin/orders"} class="block px-3 py-2 rounded hover:bg-gray-50">Orders</.link>
          <.link href={~p"/admin/reviews"} class="block px-3 py-2 rounded hover:bg-gray-50">Reviews</.link>
          <.link href={~p"/admin/analytics"} class="block px-3 py-2 rounded hover:bg-gray-50">Analytics</.link>
          <.link href={~p"/admin/settings"} class="block px-3 py-2 rounded hover:bg-gray-50">Settings</.link>
          <div class="pt-2 mt-2 border-t">
            <.link href={~p"/browse"} class="block px-3 py-2 rounded hover:bg-gray-50">Back to Browse</.link>
          </div>
        </nav>
      </aside>
      <section class="flex-1">
        <.flash_group flash={@flash} />
        <%= @inner_content %>
      </section>
    </div>
  <% else %>
    <.flash_group flash={@flash} />
    <%= @inner_content %>
  <% end %>
  <% end %>
</main>
<!-- ========== END MAIN CONTENT ========== -->

<script>
  // Mobile menu toggle
  document.addEventListener('DOMContentLoaded', function() {
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    
    if (mobileMenuButton && mobileMenu) {
      mobileMenuButton.addEventListener('click', function() {
        mobileMenu.classList.toggle('hidden');
        const isExpanded = mobileMenuButton.getAttribute('aria-expanded') === 'true';
        mobileMenuButton.setAttribute('aria-expanded', !isExpanded);
      });
    }
  });
</script>
