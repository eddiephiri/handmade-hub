<div class="min-h-screen bg-gray-50">
  <!-- Hero Section -->
  <div class="relative overflow-hidden bg-gradient-to-br from-indigo-600 via-purple-600 to-pink-600">
    <div class="absolute inset-0 bg-black/10"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20">
      <!-- Authentication Buttons -->
      <div class="flex justify-end mb-8">
        <%= if @current_user do %>
          <div class="flex items-center gap-4">
            <div class="glass-effect rounded-full px-4 py-2">
              <span class="text-white text-sm font-medium">Welcome, <%= @current_user.name || @current_user.email %></span>
            </div>
            <.link navigate={~p"/cart"} class="glass-effect px-4 py-2 rounded-full text-white hover:bg-white/30 transition-all duration-300 flex items-center gap-2 relative">
              <.icon name="hero-shopping-cart" class="w-5 h-5" />
              Cart
              <%= if @cart_item_count > 0 do %>
                <span class="absolute -top-1 -right-1 bg-yellow-400 text-indigo-900 text-xs font-bold rounded-full h-5 w-5 flex items-center justify-center">
                  <%= @cart_item_count %>
                </span>
              <% end %>
            </.link>
            <.link navigate={~p"/artisan/dashboard"} class="glass-effect px-4 py-2 rounded-full text-white hover:bg-white/30 transition-all duration-300 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3.75A2.25 2.25 0 004.5 6v2.25A2.25 2.25 0 006.75 10.5h2.25A2.25 2.25 0 0011.25 8.25V6A2.25 2.25 0 009 3.75H6.75zM15.75 3.75A2.25 2.25 0 0118 6v2.25A2.25 2.25 0 0115.75 10.5h-2.25A2.25 2.25 0 0111.25 8.25V6A2.25 2.25 0 0113.5 3.75h2.25zM6.75 13.5A2.25 2.25 0 004.5 15.75V18a2.25 2.25 0 002.25 2.25h2.25A2.25 2.25 0 0011.25 18v-2.25A2.25 2.25 0 009 13.5H6.75zM15.75 13.5A2.25 2.25 0 0118 15.75V18a2.25 2.25 0 01-2.25 2.25h-2.25A2.25 2.25 0 0111.25 18v-2.25A2.25 2.25 0 0113.5 13.5h2.25z" />
              </svg>
              Dashboard
            </.link>
            <.link href={~p"/users/log_out"} method="delete" class="glass-effect px-4 py-2 rounded-full text-white hover:bg-white/30 transition-all duration-300 flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6A2.25 2.25 0 005.25 5.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M18 12H9m0 0l3-3m-3 3l3 3" />
              </svg>
              Logout
            </.link>
          </div>
        <% else %>
          <div class="flex items-center gap-3">
            <.link navigate={~p"/cart"} class="glass-effect px-4 py-2 rounded-full text-white hover:bg-white/30 transition-all duration-300 flex items-center gap-2 relative">
              <.icon name="hero-shopping-cart" class="w-5 h-5" />
              Cart
              <%= if @cart_item_count > 0 do %>
                <span class="absolute -top-1 -right-1 bg-yellow-400 text-indigo-900 text-xs font-bold rounded-full h-5 w-5 flex items-center justify-center">
                  <%= @cart_item_count %>
                </span>
              <% end %>
            </.link>
            <.link navigate={~p"/users/log_in"} class="glass-effect px-6 py-2 rounded-full text-white hover:bg-white/30 transition-all duration-300 flex items-center gap-2 font-medium">
              <.icon name="hero-arrow-right-on-rectangle" class="w-4 h-4" />
              Login
            </.link>
            <.link navigate={~p"/users/register"} class="bg-white text-indigo-600 px-6 py-2 rounded-full font-semibold hover:bg-gray-100 transition-all duration-300 flex items-center gap-2 shadow-lg">
              <.icon name="hero-user-plus" class="w-4 h-4" />
              Register
            </.link>
          </div>
        <% end %>
      </div>
      
      <!-- Hero Content -->
      <div class="text-center max-w-4xl mx-auto">
        <h1 class="text-5xl md:text-7xl font-bold text-white mb-6">
          Discover
          <span class="block bg-gradient-to-r from-yellow-400 to-orange-400 bg-clip-text text-transparent">
            Handmade
          </span>
          Treasures
        </h1>
        <p class="text-xl md:text-2xl text-white/90 mb-8 max-w-2xl mx-auto leading-relaxed">
          Connect with talented artisans in Lusaka and discover unique, handcrafted products that tell a story
        </p>
        
        <!-- Stats -->
        <div class="grid grid-cols-3 gap-8 max-w-md mx-auto mb-12">
          <div class="text-center">
            <div class="text-3xl font-bold text-white"><%= length(@all_products) %></div>
            <div class="text-sm text-white/80">Products</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-white"><%= @all_products |> Enum.map(& &1.artisan) |> Enum.filter(& &1) |> Enum.uniq_by(& &1.id) |> length() %></div>
            <div class="text-sm text-white/80">Artisans</div>
          </div>
          <div class="text-center">
            <div class="text-3xl font-bold text-white">1000+</div>
            <div class="text-sm text-white/80">Happy Customers</div>
          </div>
        </div>
        
        <!-- CTA Button -->
        <button 
          phx-click={JS.dispatch("scroll", to: "#products-section")}
          class="bg-white text-indigo-600 px-8 py-4 rounded-full font-bold text-lg hover:bg-gray-100 transition-all duration-300 shadow-2xl hover:shadow-xl"
        >
          Start Shopping
          <.icon name="hero-arrow-down" class="w-5 h-5 ml-2 inline" />
        </button>
      </div>
    </div>
  </div>

  <!-- Search and Filters Section -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">Find Your Perfect Piece</h2>
        <p class="text-gray-600">Search through our curated collection of handmade items</p>
      </div>
      
      <!-- Search Bar -->
      <div class="relative group mb-8">
        <div class="absolute inset-0 bg-gradient-to-r from-indigo-500 to-purple-500 rounded-2xl blur opacity-20 group-hover:opacity-30 transition-opacity"></div>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 flex items-center pl-6 pointer-events-none">
            <.icon name="hero-magnifying-glass" class="w-5 h-5 text-gray-400" />
          </div>
          <form phx-change="search" phx-submit="search">
            <input 
              type="text" 
              name="query"
              value={@search_query}
              placeholder="Search for handmade products, artisans, or categories..." 
              class="w-full pl-14 pr-14 py-4 bg-white border border-gray-200 rounded-2xl text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all duration-300 text-lg"
            />
          </form>
          <%= if @search_query != "" do %>
            <button 
              phx-click="clear_search"
              class="absolute inset-y-0 right-0 flex items-center pr-6 transition-opacity"
            >
              <.icon name="hero-x-mark" class="w-5 h-5 text-gray-400 hover:text-gray-600" />
            </button>
          <% end %>
        </div>
      </div>
      
      <!-- Search Results Info -->
      <%= if @search_query != "" do %>
        <div class="text-center mb-6">
          <p class="text-gray-600">
            Showing <span class="font-semibold text-indigo-600"><%= length(@filtered_products) %></span> results for 
            "<span class="font-medium"><%= @search_query %></span>"
          </p>
        </div>
      <% end %>
      
      <!-- Filters and Controls -->
      <div class="flex flex-col lg:flex-row gap-4 items-center justify-between mb-8">
        <!-- Category Filters -->
        <div class="flex flex-wrap gap-2">
          <button 
            phx-click="filter_category" 
            phx-value-category="all"
            class={[
              "px-4 py-2 rounded-full transition-colors font-medium",
              if(@selected_category == nil, do: "bg-indigo-100 text-indigo-600", else: "bg-gray-100 text-gray-700 hover:bg-gray-200")
            ]}
          >
            All Categories
          </button>
          <%= for category <- get_unique_categories(@all_products) do %>
            <button 
              phx-click="filter_category" 
              phx-value-category={category}
              class={[
                "px-4 py-2 rounded-full transition-colors font-medium",
                if(@selected_category == category, do: "bg-indigo-100 text-indigo-600", else: "bg-gray-100 text-gray-700 hover:bg-gray-200")
              ]}
            >
              <%= String.capitalize(category) %>
            </button>
          <% end %>
        </div>
        
        <!-- View Mode and Sort -->
        <div class="flex items-center gap-4">
          <!-- Sort Dropdown -->
          <form phx-change="sort_products" class="flex items-center gap-2">
            <label class="text-sm text-gray-600">Sort by:</label>
            <select 
              name="sort" 
              class="bg-white border border-gray-200 rounded-lg px-3 py-2 text-sm"
            >
              <option value="newest" selected={@sort_by == "newest"}>Newest First</option>
              <option value="oldest" selected={@sort_by == "oldest"}>Oldest First</option>
              <option value="price_low" selected={@sort_by == "price_low"}>Price: Low to High</option>
              <option value="price_high" selected={@sort_by == "price_high"}>Price: High to Low</option>
              <option value="name" selected={@sort_by == "name"}>Name: A to Z</option>
            </select>
          </form>
          
          <!-- View Mode Toggle -->
          <button 
            phx-click="toggle_view_mode"
            class="bg-gray-100 p-2 rounded-lg hover:bg-gray-200 transition-colors"
          >
            <%= if @view_mode == :grid do %>
              <.icon name="hero-bars-3" class="w-5 h-5 text-gray-600" />
            <% else %>
              <.icon name="hero-squares-2x2" class="w-5 h-5 text-gray-600" />
            <% end %>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Products Section -->
  <div id="products-section" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
    <%= if length(@filtered_products) > 0 do %>
      <div class={[
        "grid gap-6",
        if(@view_mode == :grid, do: "grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5", else: "grid-cols-1 lg:grid-cols-2")
      ]}>
        <%= for product <- @filtered_products do %>
          <div class="bg-white rounded-lg group hover:shadow-xl transition-all duration-300 cursor-pointer border border-gray-100 hover:border-gray-200">
            <!-- Product Image Container -->
            <div class="relative aspect-square overflow-hidden rounded-t-lg bg-gray-50">
              <!-- Quick Actions (visible on hover) -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10">
                <div class="absolute top-3 right-3 flex flex-col gap-2">
                  <button class="bg-white/95 backdrop-blur-sm p-2 rounded-full shadow-md hover:bg-white transition-all duration-200 hover:scale-110">
                    <svg class="w-5 h-5 text-gray-700 hover:text-red-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                    </svg>
                  </button>
                  <button 
                    phx-click="quick_view"
                    phx-value-product_id={product.id}
                    class="bg-white/95 backdrop-blur-sm p-2 rounded-full shadow-md hover:bg-white transition-all duration-200 hover:scale-110"
                  >
                    <svg class="w-5 h-5 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                  </button>
                </div>
                <!-- Add to Cart button (visible on hover) -->
                <div class="absolute bottom-3 left-3 right-3 transform translate-y-full group-hover:translate-y-0 transition-transform duration-300">
                  <button 
                    phx-click="add_to_cart" 
                    phx-value-product_id={product.id}
                    disabled={product.quantity == 0}
                    class={[
                      "w-full py-2.5 px-4 rounded-lg font-medium text-sm transition-all duration-200 shadow-lg",
                      if(product.quantity > 0, 
                        do: "bg-white/95 backdrop-blur-sm text-gray-900 hover:bg-white", 
                        else: "bg-gray-400/90 text-white cursor-not-allowed")
                    ]}
                  >
                    <%= if product.quantity > 0 do %>
                      <span class="flex items-center justify-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                        </svg>
                        Add to Cart
                      </span>
                    <% else %>
                      Out of Stock
                    <% end %>
                  </button>
                </div>
              </div>
              
              <!-- Product Image -->
              <img 
                src={get_product_image(product)}
                alt={product.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                onerror="this.src='https://images.unsplash.com/photo-1578662996442-48f60103fc96?w=400&h=400&fit=crop'"
              />
              
              <!-- Badges -->
              <%= if product.quantity <= 5 && product.quantity > 0 do %>
                <div class="absolute top-3 left-3">
                  <span class="bg-orange-500 text-white px-2 py-1 rounded text-xs font-semibold">
                    Only <%= product.quantity %> left
                  </span>
                </div>
              <% end %>
              
              <%= if product.quantity == 0 do %>
                <div class="absolute inset-0 bg-white/80 flex items-center justify-center">
                  <span class="bg-gray-900 text-white px-4 py-2 rounded-lg font-semibold">
                    Sold Out
                  </span>
                </div>
              <% end %>
            </div>
            
            <!-- Product Info -->
            <div class="p-4">
              <!-- Artisan Info -->
              <div class="flex items-center gap-1.5 mb-2">
                <%= if product.artisan && product.artisan.name do %>
                  <div class="flex items-center gap-1">
                    <div class="w-5 h-5 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center">
                      <span class="text-white text-[10px] font-semibold">
                        <%= String.first(product.artisan.name) |> String.upcase() %>
                      </span>
                    </div>
                    <span class="text-xs text-gray-500 truncate max-w-[120px]">
                      <%= product.artisan.name %>
                    </span>
                  </div>
                <% end %>
                <!-- Rating -->
                <div class="ml-auto flex items-center gap-0.5">
                  <svg class="w-3.5 h-3.5 text-yellow-400 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                  <span class="text-xs text-gray-600">4.8</span>
                </div>
              </div>
              
              <!-- Product Name -->
              <h3 class="text-sm font-medium text-gray-900 mb-1 line-clamp-2 min-h-[2.5rem] group-hover:text-indigo-600 transition-colors">
                <%= product.name %>
              </h3>
              
              <!-- Product Description -->
              <p class="text-xs text-gray-500 line-clamp-2 mb-3 min-h-[2rem]">
                <%= product.description %>
              </p>
              
              <!-- Price and Stock -->
              <div class="flex items-end justify-between">
                <div>
                  <p class="text-xl font-bold text-gray-900">
                    <%= format_currency(product.price) %>
                  </p>
                  <%= if product.quantity > 0 && product.quantity <= 10 do %>
                    <p class="text-xs text-orange-600 font-medium">
                      Only <%= product.quantity %> left
                    </p>
                  <% end %>
                </div>
                
                <!-- Quick Add to Cart (visible on desktop) -->
                <button 
                  phx-click="add_to_cart" 
                  phx-value-product_id={product.id}
                  disabled={product.quantity == 0}
                  class={[
                    "hidden sm:flex items-center justify-center w-10 h-10 rounded-lg transition-all duration-200",
                    if(product.quantity > 0,
                      do: "bg-indigo-600 text-white hover:bg-indigo-700 hover:scale-110",
                      else: "bg-gray-300 text-gray-500 cursor-not-allowed")
                  ]}
                  title={if product.quantity > 0, do: "Add to cart", else: "Out of stock"}
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                  </svg>
                </button>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <!-- Empty State -->
      <div class="max-w-md mx-auto text-center py-20">
        <div class="mb-8">
          <.icon name="hero-archive-box-x-mark" class="mx-auto w-24 h-24 text-gray-400" />
        </div>
        <h3 class="text-2xl font-bold text-gray-900 mb-4">No Products Found</h3>
        <p class="text-gray-600 mb-8">
          <%= if @search_query != "" do %>
            We couldn't find any products matching "<%= @search_query %>". Try adjusting your search terms or browse all categories.
          <% else %>
            No products are available in this category right now. Check back later or browse other categories.
          <% end %>
        </p>
        <button 
          phx-click="clear_search"
          class="bg-indigo-600 text-white px-6 py-3 rounded-xl hover:bg-indigo-700 transition-colors font-medium"
        >
          Browse All Products
        </button>
      </div>
    <% end %>
  </div>

  <!-- Product Modal -->
  <%= if @show_product_modal && @selected_product do %>
    <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
      <div class="bg-white rounded-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
        <div class="p-6">
          <div class="flex justify-between items-center mb-4">
            <h2 class="text-2xl font-bold text-gray-900"><%= @selected_product.name %></h2>
            <button 
              phx-click="close_product_modal"
              class="text-gray-500 hover:text-gray-700"
            >
              <.icon name="hero-x-mark" class="w-6 h-6" />
            </button>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <div class="w-full h-80 bg-gray-100 flex items-center justify-center overflow-hidden">
                <img 
                  src={get_product_image(@selected_product)}
                  alt={@selected_product.name}
                  class="w-full h-full object-cover rounded"
                  onerror="this.src='https://images.unsplash.com/photo-1578662996442-48f60103fc96?w=400&h=300&fit=crop'"
                />
              </div>
            </div>
            
            <div>
              <div class="flex items-center gap-2 mb-4">
                <div class="w-10 h-10 bg-gradient-to-r from-indigo-500 to-purple-500 rounded-full flex items-center justify-center">
                  <span class="text-white font-bold">
                    <%= if @selected_product.artisan && @selected_product.artisan.name do %>
                      <%= @selected_product.artisan.name |> String.split() |> Enum.map(&String.first/1) |> Enum.join() |> String.upcase() %>
                    <% else %>
                      A
                    <% end %>
                  </span>
                </div>
                <div>
                  <p class="font-medium text-gray-900"><%= (@selected_product.artisan && @selected_product.artisan.name) || "Unknown Artisan" %></p>
                  <p class="text-sm text-gray-600">Artisan</p>
                </div>
              </div>
              
              <p class="text-gray-600 mb-4"><%= @selected_product.description %></p>
              
              <div class="space-y-2 mb-6">
                <div class="flex justify-between">
                  <span class="text-gray-600">Price:</span>
                  <span class="font-bold text-indigo-600"><%= format_currency(@selected_product.price) %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-600">Category:</span>
                  <span class="font-medium"><%= String.capitalize(@selected_product.category) %></span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-600">Stock:</span>
                  <span class={[
                    "font-medium",
                    if(@selected_product.quantity > 0, do: "text-green-600", else: "text-red-600")
                  ]}>
                    <%= if @selected_product.quantity > 0, do: "#{@selected_product.quantity} available", else: "Out of stock" %>
                  </span>
                </div>
              </div>
              
              <div class="flex gap-3">
                <%= if @selected_product.artisan do %>
                  <button 
                    phx-click="contact_artisan"
                    phx-value-artisan_id={@selected_product.artisan.id}
                    class="flex-1 bg-indigo-600 text-white py-3 px-4 rounded-xl hover:bg-indigo-700 transition-colors font-medium"
                  >
                    Contact Artisan
                  </button>
                <% end %>
                <button class="bg-gray-100 text-gray-700 py-3 px-4 rounded-xl hover:bg-gray-200 transition-colors">
                  <.icon name="hero-heart" class="w-5 h-5" />
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<style>
  .glass-effect {
    backdrop-filter: blur(10px);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
  
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>