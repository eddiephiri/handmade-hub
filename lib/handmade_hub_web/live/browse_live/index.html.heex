<div class="mb-8">
  <h1 class="text-3xl font-bold text-gray-900">Browse Handmade Products</h1>
  <p class="text-lg text-gray-500 mt-1">Discover unique handmade items from local artisans in Lusaka</p>
</div>

<!-- Search Bar -->
<div class="mt-6 mb-8">
  <.simple_form for={%{}} as={:search} phx-change="search" phx-submit="search" class="flex gap-4">
    <div class="flex-1">
      <.input
        name="query"
        type="text"
        placeholder="Search products..."
        value={@search_query}
        class="w-full"
      />
    </div>
    <.button type="submit" class="px-6">Search</.button>
    <%= if @search_query != "" do %>
      <.button type="button" phx-click="clear_search">Clear</.button>
    <% end %>
  </.simple_form>
</div>

<!-- Search Results Info -->
<%= if @search_query != "" do %>
  <div class="mb-4">
    <p class="text-sm text-gray-600">
      Showing <%= length(@filtered_products) %> result(s) for "<%= @search_query %>"
    </p>
  </div>
<% end %>

<!-- Products Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
  <div :for={product <- @filtered_products} class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
    <.link navigate={~p"/browse/#{product.id}"} class="block">
      <div class="aspect-w-16 aspect-h-9">
        <%= if product.image do %>
          <img src={"/uploads/#{product.image}"} alt={product.name} class="w-full h-48 object-cover">
        <% else %>
          <div class="w-full h-48 bg-gray-200 flex items-center justify-center">
            <span class="text-gray-500">No image</span>
          </div>
        <% end %>
      </div>
    </.link>
    
    <div class="p-4">
      <.link navigate={~p"/browse/#{product.id}"}>
        <h3 class="text-lg font-semibold text-gray-900 mb-2 hover:text-blue-600 transition-colors">
          <%= product.name %>
        </h3>
      </.link>
      
      <p class="text-gray-600 text-sm mb-3 line-clamp-2">
        <%= product.description %>
      </p>
      
      <!-- Artisan Info -->
      <div class="mb-3">
        <p class="text-xs text-gray-500">
          by <span class="font-medium"><%= product.artisan.name || "Anonymous Artisan" %></span>
        </p>
      </div>
      
      <div class="flex justify-between items-center mb-4">
        <span class="text-xl font-bold text-green-600">K<%= product.price %></span>
        <span class="text-sm text-gray-500">
          <%= if product.quantity > 0 do %>
            In Stock (<%= product.quantity %>)
          <% else %>
            Out of Stock
          <% end %>
        </span>
      </div>
      
      <div class="space-y-2">
        <.link navigate={~p"/browse/#{product.id}"} class="block">
          <.button class="w-full">View Details</.button>
        </.link>
        
        <%= if @current_user && @current_user.role == "buyer" && product.quantity > 0 do %>
          <.button
            phx-click="add_to_cart"
            phx-value-product_id={product.id}
            class="w-full bg-blue-600 hover:bg-blue-700"
          >
            Add to Cart
          </.button>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- Empty State -->
<%= if Enum.empty?(@filtered_products) do %>
  <div class="text-center py-12">
    <div class="mx-auto h-24 w-24 text-gray-400">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
    </div>
    <h3 class="mt-4 text-lg font-medium text-gray-900">
      <%= if @search_query != "" do %>
        No products found
      <% else %>
        No products available
      <% end %>
    </h3>
    <p class="mt-2 text-gray-500">
      <%= if @search_query != "" do %>
        Try adjusting your search terms.
      <% else %>
        Check back later for new handmade items.
      <% end %>
    </p>
  </div>
<% end %>