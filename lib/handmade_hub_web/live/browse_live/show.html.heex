<div class="max-w-6xl mx-auto">
  <.link navigate={~p"/browse"} class="inline-flex items-center text-blue-600 hover:text-blue-800 mb-6">
    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
    </svg>
    Back to Browse
  </.link>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Product Images -->
    <div class="space-y-4">
      <% main_img = @selected_image_url || (@product.product_images && Enum.find(@product.product_images, &(&1.is_primary)) && Enum.find(@product.product_images, &(&1.is_primary)).image_url) || @product.image %>
      <%= if main_img do %>
        <img 
          src={main_img} 
          alt={@product.name} 
          class="w-full h-96 object-cover rounded-lg shadow-lg"
        >
      <% else %>
        <div class="w-full h-96 bg-gray-200 flex items-center justify-center rounded-lg">
          <span class="text-gray-500 text-lg">No image available</span>
        </div>
      <% end %>

      <%= if @product.product_images && length(@product.product_images) > 0 do %>
        <div class="w-full overflow-x-auto">
          <div class="flex gap-3 min-w-max">
            <%= for img <- @product.product_images do %>
              <button phx-click="select_image" phx-value-url={img.image_url} class={[
                "w-20 h-20 rounded-md overflow-hidden border",
                (img.image_url == @selected_image_url) || img.is_primary && is_nil(@selected_image_url) && "ring-2 ring-indigo-500 border-indigo-400" || "border-gray-200 hover:border-gray-400"
              ]}>
                <img src={img.image_url} alt="Thumb" class="w-full h-full object-cover" />
              </button>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Product Details -->
    <div class="space-y-6">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 mb-2"><%= @product.name %></h1>
        <p class="text-sm text-gray-500 mb-4">
          by <.link navigate={~p"/artisans/#{@product.artisan.id}"} class="font-medium text-indigo-600 hover:text-indigo-700"><%= @product.artisan.name || "Anonymous Artisan" %></.link>
        </p>
        <div class="flex items-center gap-2">
          <div class="flex">
            <%= for i <- 1..5 do %>
              <svg class={"w-5 h-5 " <> if i <= Float.ceil(@rating_average) |> trunc, do: "text-yellow-400", else: "text-gray-300"} fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            <% end %>
          </div>
          <span class="text-sm text-gray-600">(<%= :erlang.float_to_binary(@rating_average, decimals: 1) %>)</span>
        </div>
      </div>

      <div class="border-t border-b py-4">
        <div class="flex justify-between items-center">
          <span class="text-3xl font-bold text-green-600"><%= format_currency(@product.price) %></span>
          <div class="text-right">
            <%= if @product.quantity > 0 do %>
              <span class="text-green-600 font-medium">In Stock</span>
              <p class="text-sm text-gray-500"><%= @product.quantity %> available</p>
            <% else %>
              <span class="text-red-600 font-medium">Out of Stock</span>
            <% end %>
          </div>
        </div>
      </div>

      <div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Description</h3>
        <p class="text-gray-700 leading-relaxed">
          <%= @product.description || "No description available." %>
        </p>
      </div>

      <!-- Action Buttons -->
      <%= if @current_user && @current_user.role == "buyer" do %>
        <div class="space-y-3">
          <%= if @product.quantity > 0 do %>
            <.button
              phx-click="add_to_cart"
              class="w-full bg-blue-600 hover:bg-blue-700 text-lg py-3"
            >
              Add to Cart
            </.button>
            <.button phx-click="buy_now" class="w-full bg-green-600 hover:bg-green-700 text-lg py-3">
              Buy Now
            </.button>
          <% else %>
            <.button disabled class="w-full bg-gray-400 text-lg py-3 cursor-not-allowed">
              Out of Stock
            </.button>
          <% end %>
        </div>
      <% else %>
        <div class="bg-gray-50 p-4 rounded-lg">
          <p class="text-gray-600">
            <%= if @current_user do %>
              Only buyers can purchase products.
            <% else %>
              <.link navigate={~p"/users/log_in"} class="text-blue-600 hover:text-blue-800">
                Log in
              </.link> to purchase this item.
            <% end %>
          </p>
        </div>
      <% end %>

      <!-- Leave a Review -->
      <div class="bg-white border rounded-lg p-4">
        <h3 class="text-lg font-semibold text-gray-900 mb-3">Leave a Review</h3>
        <.form for={@review_form} phx-submit="submit_review" class="space-y-3">
          <div class="flex items-center gap-3">
            <label class="text-sm text-gray-700">Rating</label>
            <div id="product-rating" class="flex items-center gap-2" role="radiogroup" aria-label="Rating" phx-hook="StarRating">
              <%= for i <- 1..5 do %>
                <label class="cursor-pointer">
                  <input type="radio" name="review[rating]" value={i} class="sr-only" />
                  <svg data-star class="w-6 h-6 text-gray-300" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                </label>
              <% end %>
            </div>
          </div>
          <.input field={@review_form[:comment]} type="textarea" placeholder="Write your feedback (optional)" />
          <.button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white">Submit Review</.button>
        </.form>
      </div>
    </div>
  </div>

  <!-- Reviews List -->
  <div class="mt-10">
    <h3 class="text-xl font-semibold text-gray-900 mb-4">Recent Reviews</h3>
    <div class="space-y-4">
      <%= for r <- @product_reviews do %>
        <div class="bg-white border rounded-lg p-4">
          <div class="flex items-center gap-2 mb-1">
            <div class="flex">
              <%= for i <- 1..5 do %>
                <svg class={"w-4 h-4 " <> if i <= r.rating, do: "text-yellow-400", else: "text-gray-300"} fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              <% end %>
            </div>
            <span class="text-xs text-gray-500"><%= Calendar.strftime(r.inserted_at, "%b %d, %Y") %></span>
            <%= if r.user do %>
              <span class="text-xs text-gray-500">• by <%= r.user.name || r.user.email %></span>
            <% end %>
          </div>
          <p class="text-sm text-gray-700"><%= r.comment %></p>
        </div>
      <% end %>
      <%= if @product_reviews == [] do %>
        <div class="text-gray-500">No reviews yet.</div>
      <% end %>
    </div>
  </div>
</div>
