<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <.link 
    navigate={~p"/buyer/dashboard"}
    class="inline-flex items-center bg-indigo-600 text-white py-2 px-4 rounded-lg hover:bg-indigo-700 font-medium"
  >
    <.icon name="hero-arrow-left" class="w-4 h-4 mr-2" />
    Back to Dashboard
  </.link>
  <!-- Breadcrumb -->
  <nav class="flex mb-8" aria-label="Breadcrumb">
    <ol class="inline-flex items-center space-x-1 md:space-x-3">
      <li class="inline-flex items-center">
        <.link navigate={~p"/orders"} class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-indigo-600">
          <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
            <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"></path>
          </svg>
          My Orders
        </.link>
      </li>
      <li>
        <div class="flex items-center">
          <svg class="w-6 h-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
          </svg>
          <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2">Order #<%= @order.order_number %></span>
        </div>
      </li>
    </ol>
  </nav>

  <!-- Order Header + Delivery Summary -->
  <div class="bg-white shadow-sm rounded-lg p-6 mb-6">
    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold text-gray-900 mb-2">
          Order #<%= @order.order_number %>
        </h1>
        <p class="text-sm text-gray-600">Placed on <%= format_date(@order.inserted_at) %></p>
        <div class="mt-3 flex flex-wrap items-center gap-2">
          <span class={["inline-flex items-center px-3 py-1 rounded-full text-xs font-medium", get_status_color(@order.status)]}>
            <%= get_status_icon(@order.status) %> <%= String.capitalize(@order.status) %>
          </span>
          <span class={["inline-flex items-center px-3 py-1 rounded-full text-xs font-medium", get_payment_status_color(@order.payment_status)]}>
            Payment: <%= String.capitalize(@order.payment_status) %>
          </span>
        </div>
      </div>

      <!-- Delivery Summary Card -->
      <div class="w-full lg:w-1/2 bg-gray-50 rounded-lg p-4 border border-gray-100">
        <div class="flex items-center justify-between mb-2">
          <p class="text-sm font-semibold text-gray-900">Delivery status</p>
          <%= if @order.delivery_assignment do %>
            <% status = @order.delivery_assignment.status %>
            <span class={["inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium", get_delivery_status_color(status)]}>
              <%= get_delivery_status_icon(status) %>
              <span class="ml-1"><%= String.capitalize(String.replace(status || "unknown", "_", " ")) %></span>
            </span>
          <% else %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700">
              ⏳ Preparing
            </span>
          <% end %>
        </div>
        <p class="text-xs text-gray-600">
          <%= if @order.delivery_assignment do %>
            <%= get_delivery_status_description(@order.delivery_assignment.status) %>
          <% else %>
            We’re confirming your order and preparing it for dispatch. A rider will be assigned soon after payment is confirmed.
          <% end %>
        </p>
        <p class="mt-2 text-[11px] text-gray-400">
          Typical deliveries within Lusaka: 1–2 business days; other areas: 2–4 business days.
        </p>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="mt-6 flex flex-wrap gap-3">
      <%= if @order.status in ["shipped", "delivered"] do %>
        <button phx-click="track_order" class="inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
          <svg class="mr-2 -ml-1 h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
          </svg>
          Track Package
        </button>
      <% end %>
      
      <%= if can_cancel_order?(@order) do %>
        <button phx-click="cancel_order" data-confirm="Are you sure you want to cancel this order?" class="inline-flex items-center px-4 py-2 border border-red-300 shadow-sm text-sm font-medium rounded-md text-red-700 bg-white hover:bg-red-50">
          <svg class="mr-2 -ml-1 h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
          Cancel Order
        </button>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Left Column - Order Items and Timeline -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Order Items -->
      <div class="bg-white shadow-sm rounded-lg p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Order Items</h2>
        <div class="space-y-4">
          <%= for item <- @order_items_with_products do %>
            <div class="flex items-start space-x-4 pb-4 border-b border-gray-200 last:border-0 last:pb-0">
              <div class="flex-shrink-0">
                <%= if item.product.product_images && length(item.product.product_images) > 0 do %>
                  <img src={hd(item.product.product_images).image_url} alt={item.product_name} class="h-20 w-20 object-cover rounded-lg" />
                <% else %>
                  <div class="h-20 w-20 bg-gray-200 rounded-lg flex items-center justify-center">
                    <svg class="h-10 w-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                  </div>
                <% end %>
              </div>
              <div class="flex-1">
                <h3 class="text-sm font-medium text-gray-900"><%= item.product_name %></h3>
                <p class="mt-1 text-sm text-gray-500">Quantity: <%= item.quantity %></p>
                <p class="mt-1 text-sm text-gray-500">Price: <%= format_price(item.product_price) %> each</p>
              </div>
              <div class="text-right">
                <p class="text-sm font-medium text-gray-900"><%= format_price(item.subtotal) %></p>
              </div>
            </div>
          <% end %>
        </div>

        <!-- Order Summary -->
        <div class="mt-6 pt-6 border-t border-gray-200">
          <div class="space-y-2">
            <div class="flex justify-between text-sm">
              <span class="text-gray-600">Subtotal</span>
              <span class="text-gray-900"><%= format_price(@order.subtotal) %></span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-600">Shipping</span>
              <span class="text-gray-900"><%= format_price(@order.shipping_fee) %></span>
            </div>
            <div class="flex justify-between text-base font-medium pt-2 border-t border-gray-200">
              <span class="text-gray-900">Total</span>
              <span class="text-gray-900"><%= format_price(@order.total) %></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Order Timeline -->
      <div class="bg-white shadow-sm rounded-lg p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Order Timeline</h2>
        <div class="flow-root">
          <ul role="list" class="-mb-8">
            <%= for {event, index} <- Enum.with_index(get_timeline_events(@order)) do %>
              <li>
                <div class="relative pb-8">
                  <%= if index != length(get_timeline_events(@order)) - 1 do %>
                    <span class="absolute top-4 left-4 -ml-px h-full w-0.5 bg-gray-200" aria-hidden="true"></span>
                  <% end %>
                  <div class="relative flex space-x-3">
                    <div>
                      <span class="h-8 w-8 rounded-full bg-indigo-500 flex items-center justify-center ring-8 ring-white">
                        <span class="text-white text-sm"><%= event.icon %></span>
                      </span>
                    </div>
                    <div class="min-w-0 flex-1 pt-1.5 flex justify-between space-x-4">
                      <div>
                        <p class="text-sm font-medium text-gray-900"><%= event.title %></p>
                        <p class="text-sm text-gray-500"><%= event.description %></p>
                      </div>
                      <div class="text-right text-sm whitespace-nowrap text-gray-500">
                        <%= format_date_short(event.timestamp) %>
                      </div>
                    </div>
                  </div>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      </div>

      <!-- Delivery Tracking -->
      <%= if has_delivery_assignment?(@order) do %>
        <% assignment = @order.delivery_assignment %>
        <% rider = assignment.rider %>
        <div class="bg-white shadow-sm rounded-lg p-6">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-semibold text-gray-900">Delivery Tracking</h2>
            <span class={["inline-flex items-center px-3 py-1 rounded-full text-sm font-medium", get_delivery_status_color(assignment.status)]}>
              <%= get_delivery_status_icon(assignment.status) %> <%= String.capitalize(String.replace(assignment.status, "_", " ")) %>
            </span>
          </div>

          <p class="text-sm text-gray-600 mb-6">
            <%= get_delivery_status_description(assignment.status) %>
          </p>

          <!-- Rider Information -->
          <div class="bg-gray-50 rounded-lg p-4 mb-6">
            <h3 class="text-sm font-semibold text-gray-900 mb-3">Delivery Rider</h3>
            <div class="space-y-3">
              <div class="flex items-center">
                <svg class="h-5 w-5 text-gray-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                <div>
                  <p class="text-sm font-medium text-gray-900"><%= rider.name %></p>
                  <p class="text-xs text-gray-500">Delivery Rider</p>
                </div>
              </div>

              <%= if rider.phone_number do %>
                <div class="flex items-center">
                  <svg class="h-5 w-5 text-gray-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  <div class="flex-1">
                    <p class="text-sm font-medium text-gray-900"><%= rider.phone_number %></p>
                    <div class="flex items-center space-x-3 mt-1">
                      <a 
                        href={"tel:#{format_rider_phone(rider.phone_number)}"} 
                        class="text-xs text-indigo-600 hover:text-indigo-500 font-medium inline-flex items-center"
                      >
                        <svg class="h-3 w-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                        </svg>
                        Call
                      </a>
                      <a 
                        href={"sms:#{format_rider_phone(rider.phone_number)}"} 
                        class="text-xs text-indigo-600 hover:text-indigo-500 font-medium inline-flex items-center"
                      >
                        <svg class="h-3 w-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                        </svg>
                        Text
                      </a>
                    </div>
                  </div>
                </div>
              <% end %>

              <%= if rider.vehicle_type do %>
                <div class="flex items-center">
                  <svg class="h-5 w-5 text-gray-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <div>
                    <p class="text-sm text-gray-900"><%= String.capitalize(rider.vehicle_type) %></p>
                    <p class="text-xs text-gray-500">Vehicle Type</p>
                  </div>
                </div>
              <% end %>
            </div>
          </div>

          <!-- Delivery Timeline -->
          <%= if length(get_delivery_timeline_events(@order)) > 0 do %>
            <div>
              <h3 class="text-sm font-semibold text-gray-900 mb-4">Delivery Progress</h3>
              <div class="flow-root">
                <ul role="list" class="-mb-8">
                  <%= for {event, index} <- Enum.with_index(get_delivery_timeline_events(@order)) do %>
                    <li>
                      <div class="relative pb-8">
                        <%= if index != length(get_delivery_timeline_events(@order)) - 1 do %>
                          <span class="absolute top-4 left-4 -ml-px h-full w-0.5 bg-gray-200" aria-hidden="true"></span>
                        <% end %>
                        <div class="relative flex space-x-3">
                          <div>
                            <span class="h-8 w-8 rounded-full bg-indigo-500 flex items-center justify-center ring-8 ring-white">
                              <span class="text-white text-sm"><%= event.icon %></span>
                            </span>
                          </div>
                          <div class="min-w-0 flex-1 pt-1.5">
                            <div>
                              <p class="text-sm font-medium text-gray-900"><%= event.title %></p>
                              <p class="text-sm text-gray-500"><%= event.description %></p>
                            </div>
                            <div class="mt-1 text-xs text-gray-400">
                              <%= format_date_short(event.timestamp) %>
                            </div>
                          </div>
                        </div>
                      </div>
                    </li>
                  <% end %>
                </ul>
              </div>
            </div>
          <% end %>

          <!-- Delivery Notes (if failed) -->
          <%= if assignment.status == "failed" && present?(assignment.notes) do %>
            <div class="mt-4 p-3 bg-red-50 border border-red-200 rounded-lg">
              <p class="text-sm text-red-800">
                <span class="font-medium">Note:</span> <%= assignment.notes %>
              </p>
            </div>
          <% end %>
        </div>
      <% else %>
        <!-- Empty State: No Delivery Assignment -->
        <%= if @order.status in ["processing", "shipped", "delivered"] && @order.payment_status == "paid" do %>
          <div class="bg-white shadow-sm rounded-lg p-6">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Delivery Tracking</h2>
            <div class="text-center py-6">
              <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <h3 class="mt-2 text-sm font-medium text-gray-900">Delivery Not Yet Assigned</h3>
              <p class="mt-1 text-sm text-gray-500">A delivery rider will be assigned to your order soon.</p>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <!-- Right Column - Shipping and Payment Info -->
    <div class="space-y-6">
      <!-- Shipping Information -->
      <div class="bg-white shadow-sm rounded-lg p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Shipping Information</h2>
        <%= if @order.shipping_address do %>
          <% address = @order.shipping_address %>
          <div class="text-sm text-gray-600 space-y-1">
            <p class="font-medium text-gray-900"><%= address.recipient_name %></p>
            <%= for line <- shipping_address_lines(address) do %>
              <p><%= line %></p>
            <% end %>
            <p class="pt-2">Phone: <%= address.phone_number %></p>
            <div class="pt-2 flex items-start justify-between gap-2">
              <div class="flex-1">
                <p class="text-gray-500">
                  <span class="font-medium text-gray-700">Instructions:</span>
                  <%= if present?(address.delivery_instructions) do %>
                    <%= address.delivery_instructions %>
                  <% else %>
                    <span class="italic text-gray-400">No special delivery instructions provided.</span>
                  <% end %>
                </p>
              </div>
              <%= if can_edit_delivery_instructions?(@order) do %>
                <button
                  type="button"
                  phx-click="open_edit_instructions"
                  class="ml-2 inline-flex items-center px-2 py-1 border border-gray-300 rounded-md text-xs font-medium text-gray-700 bg-white hover:bg-gray-50"
                >
                  Edit
                </button>
              <% end %>
            </div>
          </div>
        <% else %>
          <p class="text-sm text-gray-500">No shipping information available</p>
        <% end %>
      </div>

      <!-- Payment Information -->
      <div class="bg-white shadow-sm rounded-lg p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Payment Information</h2>
        <div class="text-sm text-gray-600 space-y-2">
          <div class="flex justify-between">
            <span>Method:</span>
            <span class="font-medium text-gray-900">
              <%= String.capitalize(String.replace(@order.payment_method || "N/A", "_", " ")) %>
            </span>
          </div>
          <%= if @order.mobile_money_provider do %>
            <div class="flex justify-between">
              <span>Provider:</span>
              <span class="font-medium text-gray-900"><%= @order.mobile_money_provider %></span>
            </div>
          <% end %>
          <%= if @order.payment_reference do %>
            <div class="flex justify-between">
              <span>Reference:</span>
              <span class="font-medium text-gray-900"><%= @order.payment_reference %></span>
            </div>
          <% end %>
          <div class="flex justify-between">
            <span>Status:</span>
            <span class={["inline-flex items-center px-2 py-0.5 rounded text-xs font-medium", get_payment_status_color(@order.payment_status)]}>
              <%= String.capitalize(@order.payment_status) %>
            </span>
          </div>
        </div>
      </div>

      <!-- Customer Information -->
      <div class="bg-white shadow-sm rounded-lg p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Customer Information</h2>
        <div class="text-sm text-gray-600 space-y-1">
          <p class="font-medium text-gray-900"><%= @order.customer_name || "N/A" %></p>
          <p>Email: <%= @order.customer_email || "N/A" %></p>
          <p>Phone: <%= @order.customer_phone || "N/A" %></p>
        </div>
      </div>
    </div>
  </div>

  <!-- Edit Delivery Instructions Modal -->
  <.modal :if={@show_edit_instructions_modal} id="edit-delivery-instructions-modal" show>
    <div class="p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-2">Update delivery instructions</h2>
      <p class="text-sm text-gray-600 mb-4">
        Add landmarks or gate details to help the rider find your address more easily. You can update this before your order is on the way.
      </p>
      <form phx-submit="save_delivery_instructions" class="space-y-4">
        <textarea
          name="delivery_instructions"
          rows="4"
          class="w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm"
        ><%= @instructions_value %></textarea>
        <div class="flex justify-end gap-3">
          <button
            type="button"
            phx-click={JS.push("save_delivery_instructions", value: %{"delivery_instructions" => @instructions_value})}
            class="hidden"
          >
          </button>
          <button
            type="button"
            phx-click={JS.patch(~p"/orders/#{@order.id}")}
            class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50"
          >
            Cancel
          </button>
          <button
            type="submit"
            class="inline-flex items-center px-4 py-2 border border-transparent rounded-md text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700"
          >
            Save
          </button>
        </div>
      </form>
    </div>
  </.modal>
</div>
