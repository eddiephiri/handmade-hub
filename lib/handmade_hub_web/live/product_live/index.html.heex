<.header>
  My Products
  <:actions>
    <.link navigate={~p"/products/new"}>
      <.button>New Product</.button>
    </.link>
  </:actions>
</.header>

<div id="products" phx-update="stream" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-6">
  <div :for={{id, product} <- @streams.products} id={id} class="bg-white rounded-lg shadow-md overflow-hidden">
    <div class="flex flex-col gap-2">
      <span class="text-xs text-gray-500">Cover (object-top, cropped):</span>
      <div class="aspect-w-1 aspect-h-1 bg-gray-100 flex items-center justify-center overflow-hidden">
        <img 
          src={get_product_image(product)} 
          alt={product.name} 
          class="w-full h-full object-cover rounded"
          onerror="this.src='https://via.placeholder.com/400x400?text=No+Image'"
        >
      </div>
      <span class="text-xs text-gray-500 mt-2">Contain (full image, letterboxed):</span>
      <div class="aspect-w-2 aspect-h-3 bg-gray-100 flex items-center justify-center overflow-hidden">
        <img 
          src={get_product_image(product)} 
          alt={product.name} 
          class="w-full h-full object-contain rounded"
          onerror="this.src='https://via.placeholder.com/400x400?text=No+Image'"
        >
      </div>
    </div>
    
    <div class="p-4">
      <h3 class="text-lg font-semibold text-gray-900 mb-2"><%= product.name %></h3>
      <p class="text-gray-600 text-sm mb-3 line-clamp-2"><%= product.description %></p>
      
      <div class="flex justify-between items-center mb-4">
        <span class="text-xl font-bold text-green-600">K<%= product.price %></span>
        <span class="text-sm text-gray-500">Qty: <%= product.quantity %></span>
      </div>
      
      <div class="flex space-x-2">
        <.link navigate={~p"/products/#{product.id}"} class="flex-1">
          <.button class="w-full">View</.button>
        </.link>
        <.link navigate={~p"/products/#{product}/edit"} class="flex-1">
          <.button class="w-full">Edit</.button>
        </.link>
        <.button
          phx-click="delete"
          phx-value-id={product.id}
          data-confirm="Are you sure?"
          class="px-3 py-2 bg-red-600 text-white rounded hover:bg-red-700"
        >
          Delete
        </.button>
      </div>
    </div>
  </div>
</div>

<%= if map_size(@streams.products) == 0 do %>
  <div class="text-center py-12">
    <div class="mx-auto h-24 w-24 text-gray-400">
      <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
      </svg>
    </div>
    <h3 class="mt-4 text-lg font-medium text-gray-900">No products yet</h3>
    <p class="mt-2 text-gray-500">Get started by creating your first product.</p>
    <div class="mt-6">
      <.link navigate={~p"/products/new"}>
        <.button>New Product</.button>
      </.link>
    </div>
  </div>
<% end %>

<.modal :if={@live_action in [:new, :edit]} id="product-modal" show on_cancel={JS.navigate(~p"/products")}>
  <.live_component
    module={HandmadeHubWeb.ProductLive.FormComponent}
    id={(@product && @product.id) || :new}
    title={@page_title}
    action={@live_action}
    product={@product}
    current_user={@current_user}
    navigate={~p"/products"}
  />
</.modal>