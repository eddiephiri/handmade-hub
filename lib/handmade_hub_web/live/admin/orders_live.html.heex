<div class="max-w-7xl mx-auto p-6">
  <h1 class="text-2xl font-bold mb-4">Orders</h1>

  <div class="flex items-center gap-3 mb-4">
    <form phx-change="search">
      <.input name="q" value={@search} placeholder="Search orders..." phx-debounce="400" />
    </form>
    <form phx-change="filter" class="flex items-center gap-2">
      <select name="status" class="border rounded px-2 py-1" value={@status}>
        <option value="">All statuses</option>
        <option value="pending">Pending</option>
        <option value="processing">Processing</option>
        <option value="shipped">Shipped</option>
        <option value="delivered">Delivered</option>
        <option value="cancelled">Cancelled</option>
      </select>
      <select name="payment_status" class="border rounded px-2 py-1" value={@payment_status}>
        <option value="">All payments</option>
        <option value="pending">Pending</option>
        <option value="paid">Paid</option>
        <option value="failed">Failed</option>
        <option value="refunded">Refunded</option>
      </select>
    </form>
  </div>

  <div class="bg-white border rounded">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-gray-50 text-left">
          <th class="p-3">Order #</th>
          <th class="p-3">Customer</th>
          <th class="p-3">Status</th>
          <th class="p-3">Payment</th>
          <th class="p-3">Total</th>
          <th class="p-3">Actions</th>
        </tr>
      </thead>
      <tbody>
        <%= for o <- @orders do %>
          <tr class="border-t">
            <td class="p-3"><%= o.order_number %></td>
            <td class="p-3"><%= if o.user, do: (o.user.name || o.user.email), else: (o.customer_name || o.customer_email || "—") %></td>
            <td class="p-3">
              <select phx-change="update_status" phx-value-id={o.id} name="status" class="border rounded px-2 py-1">
                <%= for s <- ["pending", "processing", "shipped", "delivered", "cancelled"] do %>
                  <option value={s} selected={o.status == s}><%= String.capitalize(s) %></option>
                <% end %>
              </select>
            </td>
            <td class="p-3">
              <select phx-change="update_payment_status" phx-value-id={o.id} name="payment_status" class="border rounded px-2 py-1">
                <%= for s <- ["pending", "paid", "failed", "refunded"] do %>
                  <option value={s} selected={o.payment_status == s}><%= String.capitalize(s) %></option>
                <% end %>
              </select>
            </td>
            <td class="p-3"><%= HandmadeHubWeb.FormatHelpers.format_currency(o.total) %></td>
            <td class="p-3 space-x-2">
              <button phx-click="refund" phx-value-id={o.id} class="inline-flex items-center px-2.5 py-1.5 rounded-md text-xs font-medium bg-rose-50 text-rose-700 hover:bg-rose-100">Refund</button>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>


