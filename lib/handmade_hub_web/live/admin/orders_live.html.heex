<div class="max-w-7xl mx-auto p-6">
  <h1 class="text-2xl font-bold mb-6">Orders</h1>

  <div class="flex items-center gap-3 mb-4">
    <form phx-change="search">
      <.input name="q" value={@search} placeholder="Search orders..." phx-debounce="400" />
    </form>
    <form phx-change="filter" class="flex items-center gap-2">
      <select name="status" class="border rounded px-2 py-1" value={@status}>
        <option value="">All statuses</option>
        <option value="pending">Pending</option>
        <option value="processing">Processing</option>
        <option value="shipped">Shipped</option>
        <option value="delivered">Delivered</option>
        <option value="cancelled">Cancelled</option>
      </select>
      <select name="payment_status" class="border rounded px-2 py-1" value={@payment_status}>
        <option value="">All payments</option>
        <option value="pending">Pending</option>
        <option value="paid">Paid</option>
        <option value="failed">Failed</option>
        <option value="refunded">Refunded</option>
      </select>
    </form>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-slate-200 overflow-hidden">
    <table class="w-full">
      <thead class="bg-slate-50 border-b border-slate-200">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Order #</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Customer</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Rider</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Payment</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Total</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200">
        <%= for o <- @orders do %>
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-900"><%= o.order_number %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600"><%= if o.user, do: (o.user.name || o.user.email), else: (o.customer_name || o.customer_email || "—") %></td>
            <td class="px-6 py-4 whitespace-nowrap">
              <select phx-change="update_status" phx-value-id={o.id} name="status" class="rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm px-2 py-1.5">
                <%= for s <- ["pending", "processing", "shipped", "delivered", "cancelled"] do %>
                  <option value={s} selected={o.status == s}><%= String.capitalize(s) %></option>
                <% end %>
              </select>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">
              <%= if o.delivery_assignment && o.delivery_assignment.rider do %>
                <div class="flex items-center space-x-2">
                  <span class="text-slate-900"><%= o.delivery_assignment.rider.name %></span>
                  <button phx-click="open_assign_modal" phx-value-order_id={o.id}
                          class="text-xs text-indigo-600 hover:underline">
                    Change
                  </button>
                </div>
              <% else %>
                <button phx-click="open_assign_modal" phx-value-order_id={o.id}
                        class="text-xs text-indigo-600 hover:underline">
                  Assign Rider
                </button>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <select phx-change="update_payment_status" phx-value-id={o.id} name="payment_status" class="rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm px-2 py-1.5">
                <%= for s <- ["pending", "paid", "failed", "refunded"] do %>
                  <option value={s} selected={o.payment_status == s}><%= String.capitalize(s) %></option>
                <% end %>
              </select>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-900"><%= HandmadeHubWeb.FormatHelpers.format_currency(o.total) %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm space-x-2">
              <button phx-click="confirm_refund" phx-value-id={o.id} class="inline-flex items-center px-2.5 py-1.5 rounded-md text-xs font-medium bg-rose-50 text-rose-700 hover:bg-rose-100">Refund</button>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <%= if Enum.empty?(@orders) do %>
      <div class="text-center py-12">
        <svg class="mx-auto h-12 w-12 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
        </svg>
        <h3 class="mt-2 text-sm font-medium text-slate-900">No orders found</h3>
        <p class="mt-1 text-sm text-slate-500">Try adjusting your search or filters</p>
      </div>
    <% end %>
  </div>
</div>

<!-- Assign Rider Modal -->
<%= if @show_assign_modal do %>
  <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
    <div class="bg-white rounded-lg p-6 max-w-md w-full">
      <h2 class="text-xl font-bold mb-4">Assign Delivery Rider</h2>

      <form phx-submit="assign_rider" phx-value-order_id={@selected_order.id}>
        <select name="rider_id" class="w-full border rounded px-3 py-2 mb-4" required>
          <option value="">Select a rider...</option>
          <%= for rider <- @available_riders do %>
            <option value={rider.id}>
              <%= rider.name %> - <%= rider.phone_number %>
            </option>
          <% end %>
        </select>

        <div class="flex justify-end space-x-2">
          <button type="button" phx-click="close_assign_modal"
                  class="px-4 py-2 border rounded">Cancel</button>
          <button type="submit"
                  class="px-4 py-2 bg-indigo-600 text-white rounded">Assign</button>
        </div>
      </form>
    </div>
  </div>
<% end %>

<!-- Refund Confirmation Modal -->
<%= if @confirming_refund do %>
  <.modal id="refund-confirmation-modal" show on_cancel={JS.push("clear_refund_confirmation")}>
    <div class="p-6">
      <h2 class="text-lg font-bold mb-4">Confirm Refund</h2>
      <p class="mb-4">
        Are you sure you want to refund order <strong><%= @confirming_refund.order.order_number %></strong>?
      </p>
      <p class="mb-4 text-sm text-slate-600">
        Refund amount: <strong><%= HandmadeHubWeb.FormatHelpers.format_currency(@confirming_refund.order.total) %></strong>
      </p>
      <form phx-submit="refund" phx-value-id={@confirming_refund.order.id}>
        <div class="mb-4">
          <label class="block text-sm font-medium text-slate-700 mb-2">Reason for refund</label>
          <textarea 
            name="reason" 
            required
            class="w-full border rounded-md px-3 py-2 text-sm"
            placeholder="Enter reason for refund..."
            rows="3"
          ></textarea>
        </div>
        <div class="flex justify-end gap-4">
          <button 
            type="button"
            phx-click="clear_refund_confirmation" 
            class="px-4 py-2 rounded-md bg-gray-200 hover:bg-gray-300 text-gray-700"
          >
            Cancel
          </button>
          <button 
            type="submit"
            class="px-4 py-2 rounded-md text-white bg-rose-600 hover:bg-rose-700"
          >
            Confirm Refund
          </button>
        </div>
      </form>
    </div>
  </.modal>
<% end %>


