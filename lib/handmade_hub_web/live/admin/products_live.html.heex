<div class="max-w-7xl mx-auto p-6">
  <h1 class="text-2xl font-bold mb-6">Products</h1>

  <div class="flex items-center gap-3 mb-4">
    <form phx-change="search">
      <.input name="q" value={@search} placeholder="Search products..." phx-debounce="400" />
    </form>
    <form phx-change="filter_status">
      <select name="status" class="border rounded px-2 py-1" value={@status}>
        <option value="all">All</option>
        <option value="pending">Pending</option>
        <option value="approved">Approved</option>
        <option value="rejected">Rejected</option>
      </select>
    </form>
    <form phx-change="filter_category">
      <.input name="category" value={@category} placeholder="Category" phx-debounce="400" />
    </form>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-slate-200 overflow-hidden">
    <table class="w-full">
      <thead class="bg-slate-50 border-b border-slate-200">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Name</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Artisan</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Category</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Price</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200">
        <%= for p <- @products do %>
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-900"><.link navigate={~p"/admin/products/#{p.id}"}><%= p.name %></.link></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600"><%= if p.artisan, do: (p.artisan.name || p.artisan.email), else: "—" %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm"><span class="px-2.5 py-1 text-xs font-medium rounded-full bg-slate-50 text-slate-700"><%= String.capitalize(p.approval_status) %></span></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600"><%= p.category || "—" %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-900"><%= HandmadeHubWeb.FormatHelpers.format_currency(p.price) %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm space-x-2 text-right">
              <button phx-click="view_product" phx-value-id={p.id} class="inline-flex items-center px-2.5 py-1.5 rounded-md text-xs font-medium bg-blue-50 text-blue-700 hover:bg-blue-100">View</button>
              <%= if p.approval_status != "approved" do %>
                <button phx-click="approve" phx-value-id={p.id} class="inline-flex items-center px-2.5 py-1.5 rounded-md text-xs font-medium bg-emerald-50 text-emerald-700 hover:bg-emerald-100">Approve</button>
              <% end %>
              <%= if p.approval_status != "rejected" do %>
                <button phx-click="reject" phx-value-id={p.id} class="inline-flex items-center px-2.5 py-1.5 rounded-md text-xs font-medium bg-amber-50 text-amber-700 hover:bg-amber-100">Reject</button>
              <% end %>
              <button phx-click="remove" phx-value-id={p.id} class="inline-flex items-center px-2.5 py-1.5 rounded-md text-xs font-medium bg-rose-50 text-rose-700 hover:bg-rose-100">Remove</button>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <%= if Enum.empty?(@products) do %>
      <div class="text-center py-12">
        <svg class="mx-auto h-12 w-12 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
        </svg>
        <h3 class="mt-2 text-sm font-medium text-slate-900">No products found</h3>
        <p class="mt-1 text-sm text-slate-500">Try adjusting your search or filters</p>
      </div>
    <% end %>
  </div>
</div>

<!-- Product View Modal -->
<%= if @show_view_modal && @selected_product do %>
  <.modal id="view-product-modal" show on_cancel={JS.push("close_view_modal")}>
    <div class="max-w-4xl mx-auto">
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold text-slate-900"><%= @selected_product.name %></h2>
        <button 
          phx-click="close_view_modal"
          class="text-slate-400 hover:text-slate-600 transition-colors"
        >
          <.icon name="hero-x-mark" class="w-6 h-6" />
        </button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Product Images -->
        <div>
          <%= if length(@selected_product.product_images) > 0 do %>
            <div class="mb-4">
              <img 
                src={List.first(@selected_product.product_images).image_url} 
                alt={@selected_product.name}
                class="w-full h-80 object-cover rounded-lg border border-slate-200"
                onerror="this.src='https://images.unsplash.com/photo-1578662996442-48f60103fc96?w=400&h=300&fit=crop'"
              />
            </div>
            <%= if length(@selected_product.product_images) > 1 do %>
              <div class="grid grid-cols-4 gap-2">
                <%= for img <- Enum.take(@selected_product.product_images, 4) do %>
                  <img 
                    src={img.image_url} 
                    alt={@selected_product.name}
                    class="w-full h-20 object-cover rounded border border-slate-200"
                    onerror="this.src='https://images.unsplash.com/photo-1578662996442-48f60103fc96?w=400&h=300&fit=crop'"
                  />
                <% end %>
              </div>
            <% end %>
          <% else %>
            <div class="w-full h-80 bg-slate-100 rounded-lg border border-slate-200 flex items-center justify-center">
              <span class="text-slate-400">No images available</span>
            </div>
          <% end %>
        </div>

        <!-- Product Details -->
        <div class="space-y-4">
          <div class="bg-slate-50 rounded-lg p-4">
            <h3 class="font-semibold text-slate-900 mb-3">Product Information</h3>
            <dl class="space-y-2 text-sm">
              <div class="flex justify-between">
                <dt class="text-slate-600">Artisan:</dt>
                <dd class="text-slate-900 font-medium">
                  <%= if @selected_product.artisan, do: (@selected_product.artisan.name || @selected_product.artisan.email), else: "—" %>
                </dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-slate-600">Status:</dt>
                <dd class="text-slate-900">
                  <span class="px-2.5 py-1 text-xs font-medium rounded-full bg-slate-100 text-slate-700">
                    <%= String.capitalize(@selected_product.approval_status) %>
                  </span>
                </dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-slate-600">Category:</dt>
                <dd class="text-slate-900 font-medium"><%= @selected_product.category || "—" %></dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-slate-600">Price:</dt>
                <dd class="text-slate-900 font-medium"><%= HandmadeHubWeb.FormatHelpers.format_currency(@selected_product.price) %></dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-slate-600">Quantity:</dt>
                <dd class="text-slate-900 font-medium"><%= @selected_product.quantity %></dd>
              </div>
            </dl>
          </div>

          <div class="bg-slate-50 rounded-lg p-4">
            <h3 class="font-semibold text-slate-900 mb-3">Description</h3>
            <p class="text-sm text-slate-700 whitespace-pre-line"><%= @selected_product.description %></p>
          </div>

          <!-- Action Buttons -->
          <div class="flex gap-2 pt-4">
            <%= if @selected_product.approval_status != "approved" do %>
              <button 
                phx-click="approve" 
                phx-value-id={@selected_product.id}
                class="flex-1 inline-flex items-center justify-center px-4 py-2 rounded-md text-sm font-medium bg-emerald-50 text-emerald-700 hover:bg-emerald-100"
              >
                Approve
              </button>
            <% end %>
            <%= if @selected_product.approval_status != "rejected" do %>
              <button 
                phx-click="reject" 
                phx-value-id={@selected_product.id}
                class="flex-1 inline-flex items-center justify-center px-4 py-2 rounded-md text-sm font-medium bg-amber-50 text-amber-700 hover:bg-amber-100"
              >
                Reject
              </button>
            <% end %>
            <button 
              phx-click="remove" 
              phx-value-id={@selected_product.id}
              class="flex-1 inline-flex items-center justify-center px-4 py-2 rounded-md text-sm font-medium bg-rose-50 text-rose-700 hover:bg-rose-100"
            >
              Remove
            </button>
          </div>
        </div>
      </div>
    </div>
  </.modal>
<% end %>


