<div class="max-w-5xl mx-auto p-6">
  <.link navigate={~p"/admin/products"} class="text-sm text-indigo-600">← Back</.link>
  <h1 class="text-2xl font-bold mt-2 mb-6"><%= @product.name %></h1>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="bg-white border rounded p-4">
      <h2 class="font-semibold mb-3">Details</h2>
      <p class="text-sm text-gray-600">Artisan: <%= if @product.artisan, do: (@product.artisan.name || @product.artisan.email), else: "—" %></p>
      <p class="text-sm text-gray-600">Status: <%= String.capitalize(@product.approval_status) %></p>
      <p class="text-sm text-gray-600">Category: <%= @product.category || "—" %></p>
      <p class="text-sm text-gray-600">Price: <%= HandmadeHubWeb.FormatHelpers.format_currency(@product.price) %></p>
      <p class="text-sm text-gray-600">Quantity: <%= @product.quantity %></p>
      <p class="text-sm text-gray-600 mt-2 whitespace-pre-line"><%= @product.description %></p>
    </div>

    <div class="bg-white border rounded p-4">
      <h2 class="font-semibold mb-3">Actions</h2>
      <div class="space-x-2">
        <button phx-click="confirm_set_status" phx-value-status="approved" class="inline-flex items-center px-2.5 py-1.5 rounded-md text-xs font-medium bg-emerald-50 text-emerald-700 hover:bg-emerald-100">Approve</button>
        <button phx-click="confirm_set_status" phx-value-status="rejected" class="inline-flex items-center px-2.5 py-1.5 rounded-md text-xs font-medium bg-amber-50 text-amber-700 hover:bg-amber-100">Reject</button>
        <button phx-click="confirm_remove" class="inline-flex items-center px-2.5 py-1.5 rounded-md text-xs font-medium bg-rose-50 text-rose-700 hover:bg-rose-100">Remove</button>
      </div>
      <div class="mt-4">
        <.simple_form for={@category_form} phx-submit="save_category">
          <.input field={@category_form[:category]} label="Category" />
          <:actions>
            <.button>Save</.button>
          </:actions>
        </.simple_form>
      </div>
    </div>
  </div>

  <div class="bg-white border rounded p-4 mt-6">
    <h3 class="font-semibold mb-3">Images</h3>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      <%= for img <- @product.product_images do %>
        <img src={img.image_url} class="w-full h-32 object-cover rounded" />
      <% end %>
    </div>
  </div>
</div>

<!-- Confirmation Modal -->
<%= if @confirming_action do %>
  <.modal id="confirmation-modal" show on_cancel={JS.push("clear_confirmation")}>
    <div class="p-6">
      <h2 class="text-lg font-bold mb-4">Confirm Action</h2>
      <p class="mb-6">
        <%= case @confirming_action.action do %>
          <% "set_status" -> %>
            <%= case @confirming_action.status do %>
              <% "approved" -> %>
                Are you sure you want to approve this product?
              <% "rejected" -> %>
                Are you sure you want to reject this product?
            <% end %>
          <% "remove" -> %>
            Are you sure you want to remove this product? This action cannot be undone.
        <% end %>
      </p>
      <div class="flex justify-end gap-4">
        <button phx-click="clear_confirmation" class="px-4 py-2 rounded-md bg-gray-200 hover:bg-gray-300 text-gray-700">
          Cancel
        </button>
        <button 
          phx-click={if @confirming_action.action == "set_status", do: "set_status", else: "remove"}
          phx-value-status={if @confirming_action.action == "set_status", do: @confirming_action.status}
          class="px-4 py-2 rounded-md text-white <%= case @confirming_action do
            %{action: "set_status", status: "approved"} -> "bg-emerald-600 hover:bg-emerald-700"
            %{action: "set_status", status: "rejected"} -> "bg-amber-600 hover:bg-amber-700"
            %{action: "remove"} -> "bg-rose-600 hover:bg-rose-700"
          end %>"
        >
          Confirm
        </button>
      </div>
    </div>
  </.modal>
<% end %>


