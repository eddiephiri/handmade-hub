<div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 py-8">
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Back Navigation -->
    <div class="mb-8">
      <.link 
        navigate={~p"/admin/admins"} 
        class="inline-flex items-center text-sm font-medium text-indigo-600 hover:text-indigo-500 transition-colors duration-200"
      >
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to Admins
      </.link>
    </div>

    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">Edit Admin</h1>
      <p class="text-gray-600">Update admin information and permissions</p>
    </div>

    <!-- Form Card -->
    <div class="bg-white rounded-xl shadow-lg border border-gray-200 overflow-hidden">
      <div class="px-6 py-8 sm:px-8">
        <.simple_form for={@form} as={:admin} phx-submit="save">
          <!-- Username Field -->
          <div class="mb-6">
            <.input 
              field={@form[:username]} 
              label="Username" 
              class="form-input-enhanced"
            />
          </div>

          <!-- Email Field -->
          <div class="mb-6">
            <.input 
              field={@form[:email]} 
              label="Email" 
              type="email"
              class="form-input-enhanced"
            />
          </div>

          <!-- Role Field -->
          <div class="mb-8">
            <label class="block text-sm font-semibold text-gray-700 mb-3">
              Role
            </label>
            <div class="relative">
              <select 
                name="admin[role]" 
                class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-white text-gray-900 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all duration-200 shadow-sm hover:shadow-md"
              >
                <%= for r <- ["super_admin", "moderator", "support", "analyst"] do %>
                  <option value={r} selected={@admin.role == r} class="py-2">
                    <%= String.split(r, "_") |> Enum.map(&String.capitalize/1) |> Enum.join(" ") %>
                  </option>
                <% end %>
              </select>
              <div class="absolute inset-y-0 right-0 flex items-center pr-3 pointer-events-none">
                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </div>
            <p class="mt-2 text-sm text-gray-500">
              Select the appropriate role for this admin user
            </p>
          </div>

          <:actions>
            <div class="flex items-center justify-between pt-6 border-t border-gray-200">
              <div class="text-sm text-gray-500">
                Last updated: <%= Calendar.strftime(@admin.updated_at, "%B %d, %Y at %I:%M %p") %>
              </div>
              <div class="flex space-x-3">
                <.link 
                  navigate={~p"/admin/admins"} 
                  class="px-6 py-3 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition-all duration-200"
                >
                  Cancel
                </.link>
                <button 
                  type="submit"
                  class="px-6 py-3 text-sm font-medium text-white bg-indigo-600 border border-transparent rounded-lg hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 transition-all duration-200 shadow-sm hover:shadow-md"
                >
                  Save Changes
                </button>
              </div>
            </div>
          </:actions>
        </.simple_form>
      </div>
    </div>

    <!-- Admin Info Card -->
    <div class="mt-6 bg-white rounded-xl shadow-lg border border-gray-200 overflow-hidden">
      <div class="px-6 py-4 bg-gray-50 border-b border-gray-200">
        <h3 class="text-lg font-semibold text-gray-900">Admin Information</h3>
      </div>
      <div class="px-6 py-4">
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <dt class="text-sm font-medium text-gray-500">Admin ID</dt>
            <dd class="mt-1 text-sm text-gray-900 font-mono">#<%= @admin.id %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Status</dt>
            <dd class="mt-1">
              <%= if @admin.confirmed_at do %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                  <svg class="w-1.5 h-1.5 mr-1" fill="currentColor" viewBox="0 0 8 8">
                    <circle cx="4" cy="4" r="3" />
                  </svg>
                  Confirmed
                </span>
              <% else %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                  <svg class="w-1.5 h-1.5 mr-1" fill="currentColor" viewBox="0 0 8 8">
                    <circle cx="4" cy="4" r="3" />
                  </svg>
                  Pending
                </span>
              <% end %>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Created</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= Calendar.strftime(@admin.inserted_at, "%B %d, %Y") %></dd>
          </div>
          <div>
            <dt class="text-sm font-medium text-gray-500">Email Verified</dt>
            <dd class="mt-1">
              <%= if @admin.confirmed_at do %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                  <svg class="w-1.5 h-1.5 mr-1" fill="currentColor" viewBox="0 0 8 8">
                    <circle cx="4" cy="4" r="3" />
                  </svg>
                  Verified
                </span>
              <% else %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                  <svg class="w-1.5 h-1.5 mr-1" fill="currentColor" viewBox="0 0 8 8">
                    <circle cx="4" cy="4" r="3" />
                  </svg>
                  Not Verified
                </span>
              <% end %>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</div>

<style>
  .form-input-enhanced {
    @apply mt-2 block w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-900 shadow-sm transition-all duration-200 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 hover:shadow-md;
  }
  
  .form-input-enhanced:focus {
    @apply outline-none;
  }
  
  .form-input-enhanced:invalid {
    @apply border-red-300 focus:border-red-500 focus:ring-red-500;
  }
</style>


