<div class="max-w-7xl mx-auto p-6">
  <div class="mb-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-3xl font-bold text-slate-800">Admin Management</h1>
        <p class="text-slate-600 mt-1">Manage admin users and their permissions</p>
      </div>
      <%= if @current_admin.role == "super_admin" do %>
        <button
          phx-click="open_modal"
          class="inline-flex items-center px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-medium rounded-lg shadow-sm transition-colors"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 4v16m8-8H4"
            />
          </svg>
          Create New Admin
        </button>
      <% end %>
    </div>
  </div>

  <div class="flex items-center gap-3 mb-6">
    <form phx-change="search" class="flex-1 max-w-md">
      <.input
        name="q"
        value={@search}
        placeholder="Search by username or email..."
        phx-debounce="400"
      />
    </form>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-slate-200 overflow-hidden">
    <table class="w-full">
      <thead class="bg-slate-50 border-b border-slate-200">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">
            Username
          </th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">
            Email
          </th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">
            Role
          </th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">
            Status
          </th>
          <th class="px-6 py-3 text-right text-xs font-medium text-slate-500 uppercase tracking-wider">
            Actions
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200">
        <%= for admin <- @admins do %>
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center">
                <div class="flex-shrink-0 h-10 w-10 bg-indigo-100 rounded-full flex items-center justify-center">
                  <span class="text-indigo-600 font-semibold text-sm">
                    <%= String.upcase(String.first(admin.username || "A")) %>
                  </span>
                </div>
                <div class="ml-4">
                  <div class="text-sm font-medium text-slate-900"><%= admin.username %></div>
                </div>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600"><%= admin.email %></td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="px-2.5 py-1 text-xs font-medium rounded-full bg-indigo-50 text-indigo-700">
                <%= admin.role %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <% status = admin_status(admin) %>
              <span class={"px-2.5 py-1 text-xs font-medium rounded-full #{status_badge_class(status)}"}>
                <%= String.capitalize(status) %>
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <div class="flex items-center justify-end gap-2">
                <%= if @current_admin.role == "super_admin" && is_nil(admin.confirmed_at) do %>
                  <button
                    phx-click="approve"
                    phx-value-id={admin.id}
                    class="inline-flex items-center px-3 py-1.5 rounded-md text-xs font-medium bg-green-50 text-green-700 hover:bg-green-100 transition-colors"
                  >
                    Approve
                  </button>
                  <button
                    phx-click="reject"
                    phx-value-id={admin.id}
                    class="inline-flex items-center px-3 py-1.5 rounded-md text-xs font-medium bg-red-50 text-red-700 hover:bg-red-100 transition-colors"
                  >
                    Reject
                  </button>
                <% else %>
                  <.link
                    navigate={~p"/admin/admins/#{admin.id}"}
                    class="inline-flex items-center px-3 py-1.5 rounded-md text-xs font-medium bg-indigo-50 text-indigo-700 hover:bg-indigo-100 transition-colors"
                  >
                    Edit
                  </.link>
                  <button
                    phx-click="delete"
                    phx-value-id={admin.id}
                    data-confirm="Are you sure you want to delete this admin?"
                    class="inline-flex items-center px-3 py-1.5 rounded-md text-xs font-medium bg-rose-50 text-rose-700 hover:bg-rose-100 transition-colors"
                  >
                    Delete
                  </button>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <%= if @admins == [] do %>
      <div class="text-center py-12">
        <svg
          class="mx-auto h-12 w-12 text-slate-400"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
          />
        </svg>
        <h3 class="mt-2 text-sm font-medium text-slate-900">No admins found</h3>
        <p class="mt-1 text-sm text-slate-500">
          <%= if @search != "", do: "Try adjusting your search", else: "Get started by creating a new admin" %>
        </p>
      </div>
    <% end %>
  </div>
</div>

<!-- Create Admin Modal -->
<%= if @show_modal do %>
  <div
    class="fixed inset-0 bg-slate-900 bg-opacity-50 flex items-center justify-center z-50"
    phx-click="close_modal"
  >
    <div class="bg-white rounded-xl shadow-2xl max-w-md w-full mx-4" phx-click="ignore">
      <div class="px-6 py-4 border-b border-slate-200">
        <div class="flex items-center justify-between">
          <h3 class="text-xl font-semibold text-slate-900">Create New Admin</h3>
          <button
            phx-click="close_modal"
            class="text-slate-400 hover:text-slate-600 transition-colors"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"
              />
            </svg>
          </button>
        </div>
      </div>

      <.simple_form for={@form} phx-submit="save" phx-change="validate">
        <div class="px-6 py-4 space-y-4">
          <.input field={@form[:username]} label="Username" required placeholder="johndoe" />
          <.input
            field={@form[:email]}
            type="email"
            label="Email"
            required
            placeholder="admin@example.com"
          />
          <.input
            field={@form[:password]}
            type="password"
            label="Password"
            required
            placeholder="Minimum 12 characters"
          />

          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Role</label>
            <select
              name="admin[role]"
              required
              class="w-full rounded-lg border-slate-300 focus:border-indigo-500 focus:ring-indigo-500"
            >
              <option value="">Select a role</option>
              <option value="moderator">Moderator</option>
              <option value="support">Support</option>
              <option value="analyst">Analyst</option>
              <%= if @current_admin.role == "super_admin" do %>
                <option value="super_admin">Super Admin</option>
              <% end %>
            </select>
          </div>

          <div class="bg-blue-50 border border-blue-200 rounded-lg p-3">
            <p class="text-xs text-blue-800">
              <strong>Note:</strong>
              The new admin will be created in a pending state and must be approved before they can log in.
            </p>
          </div>
        </div>

        <div class="px-6 py-4 bg-slate-50 rounded-b-xl flex justify-end gap-3">
          <button
            type="button"
            phx-click="close_modal"
            class="px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors"
          >
            Cancel
          </button>
          <.button class="bg-indigo-600 hover:bg-indigo-700">Create Admin</.button>
        </div>
      </.simple_form>
    </div>
  </div>
<% end %>
