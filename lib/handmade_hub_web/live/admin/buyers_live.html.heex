<div class="max-w-7xl mx-auto p-6">
  <h1 class="text-2xl font-bold mb-6">Buyers</h1>

  <div class="flex items-end gap-4 mb-6">
    <form phx-change="search">
      <.input name="q" value={@search} placeholder="Search buyers..." phx-debounce="400" />
    </form>
    <form phx-change="filter">
      <div>
        <label class="block text-xs text-slate-600 mb-1">Status</label>
        <select name="status" class="rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm px-3 py-2" value={@status}>
          <option value="all">All</option>
          <option value="active">Active</option>
          <option value="suspended">Suspended</option>
        </select>
      </div>
    </form>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-slate-200 overflow-hidden">
    <table class="w-full">
      <thead class="bg-slate-50 border-b border-slate-200">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Name</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Email</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200">
        <%= for b <- @buyers do %>
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-900"><.link navigate={~p"/admin/buyers/#{b.id}"}><%= b.name || "—" %></.link></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-600"><%= b.email %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">
              <%= if is_nil(b.suspended_at) do %>
                <span class="px-2.5 py-1 text-xs font-medium rounded-full bg-green-50 text-green-700">Active</span>
              <% else %>
                <span class="px-2.5 py-1 text-xs font-medium rounded-full bg-rose-50 text-rose-700">Suspended</span>
              <% end %>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-right">
              <%= if is_nil(b.suspended_at) do %>
                <button phx-click="confirm_toggle_suspend" phx-value-id={b.id} phx-value-suspend="true" class="inline-flex items-center px-2.5 py-1.5 rounded-md text-xs font-medium bg-rose-50 text-rose-700 hover:bg-rose-100">Suspend</button>
              <% else %>
                <button phx-click="confirm_toggle_suspend" phx-value-id={b.id} phx-value-suspend="false" class="inline-flex items-center px-2.5 py-1.5 rounded-md text-xs font-medium bg-emerald-50 text-emerald-700 hover:bg-emerald-100">Unsuspend</button>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <%= if Enum.empty?(@buyers) do %>
      <div class="text-center py-12">
        <svg class="mx-auto h-12 w-12 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
        </svg>
        <h3 class="mt-2 text-sm font-medium text-slate-900">No buyers found</h3>
        <p class="mt-1 text-sm text-slate-500">Try adjusting your search or filters</p>
      </div>
    <% end %>
  </div>
</div>

<!-- Confirmation Modal -->
<%= if @confirming_action do %>
  <.modal id="confirmation-modal" show on_cancel={JS.push("clear_confirmation")}>
    <div class="p-6">
      <h2 class="text-lg font-bold mb-4">Confirm Action</h2>
      <p class="mb-6">
        <%= if @confirming_action.suspend == "true" do %>
          Are you sure you want to suspend <strong><%= @confirming_action.user.name || @confirming_action.user.email %></strong>? They will not be able to access their account.
        <% else %>
          Are you sure you want to unsuspend <strong><%= @confirming_action.user.name || @confirming_action.user.email %></strong>? They will regain access to their account.
        <% end %>
      </p>
      <div class="flex justify-end gap-4">
        <button phx-click="clear_confirmation" class="px-4 py-2 rounded-md bg-gray-200 hover:bg-gray-300 text-gray-700">
          Cancel
        </button>
        <button 
          phx-click="toggle_suspend" 
          phx-value-id={@confirming_action.id}
          phx-value-suspend={@confirming_action.suspend}
          class={["px-4 py-2 rounded-md text-white", if(@confirming_action.suspend == "true", do: "bg-rose-600 hover:bg-rose-700", else: "bg-emerald-600 hover:bg-emerald-700")]}
        >
          Confirm
        </button>
      </div>
    </div>
  </.modal>
<% end %>