<div class="max-w-7xl mx-auto p-6">
  <h1 class="text-2xl font-bold mb-6">Reviews</h1>

  <div class="flex items-center gap-3 mb-4">
    <form phx-change="search">
      <.input name="q" value={@search} placeholder="Search comments..." phx-debounce="400" />
    </form>
    <form phx-change="filter" class="flex items-center gap-2">
      <select name="visibility" class="border rounded px-2 py-1" value={@visibility}>
        <option value="all">All</option>
        <option value="visible">Visible</option>
        <option value="hidden">Hidden</option>
      </select>
      <select name="flagged" class="border rounded px-2 py-1" value={@flagged}>
        <option value="all">All</option>
        <option value="flagged">Flagged</option>
        <option value="unflagged">Unflagged</option>
      </select>
    </form>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-slate-200 overflow-hidden">
    <table class="w-full">
      <thead class="bg-slate-50 border-b border-slate-200">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">User</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Rating</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Comment</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Visible</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Flagged</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-200">
        <%= for r <- @reviews do %>
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-900"><%= if r.user, do: (r.user.name || r.user.email), else: "—" %></td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-slate-900"><%= r.rating %> ⭐</td>
            <td class="px-6 py-4 text-sm text-slate-700 max-w-xl whitespace-pre-line"><%= r.comment %></td>
            <td class="px-6 py-4 whitespace-nowrap">
              <select phx-change="toggle_visible" phx-value-id={r.id} name="visible" class="rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm px-2 py-1.5">
                <option value="true" selected={r.visible == true}>Yes</option>
                <option value="false" selected={r.visible == false}>No</option>
              </select>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <select phx-change="toggle_flag" phx-value-id={r.id} name="flagged" class="rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm px-2 py-1.5">
                <option value="true" selected={r.flagged == true}>Yes</option>
                <option value="false" selected={r.flagged == false}>No</option>
              </select>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm">
              <button phx-click="confirm_delete" phx-value-id={r.id} class="inline-flex items-center px-2.5 py-1.5 rounded-md text-xs font-medium bg-rose-50 text-rose-700 hover:bg-rose-100">Delete</button>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <%= if Enum.empty?(@reviews) do %>
      <div class="text-center py-12">
        <svg class="mx-auto h-12 w-12 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
        </svg>
        <h3 class="mt-2 text-sm font-medium text-slate-900">No reviews found</h3>
        <p class="mt-1 text-sm text-slate-500">Try adjusting your search or filters</p>
      </div>
    <% end %>
  </div>
</div>

<!-- Confirmation Modal -->
<%= if @confirming_action do %>
  <.modal id="confirmation-modal" show on_cancel={JS.push("clear_confirmation")}>
    <div class="p-6">
      <h2 class="text-lg font-bold mb-4">Confirm Action</h2>
      <p class="mb-6">
        Are you sure you want to delete this review? This action cannot be undone.
      </p>
      <div class="flex justify-end gap-4">
        <button phx-click="clear_confirmation" class="px-4 py-2 rounded-md bg-gray-200 hover:bg-gray-300 text-gray-700">
          Cancel
        </button>
        <button 
          phx-click="delete" 
          phx-value-id={@confirming_action.id}
          class="px-4 py-2 rounded-md text-white bg-rose-600 hover:bg-rose-700"
        >
          Confirm
        </button>
      </div>
    </div>
  </.modal>
<% end %>


