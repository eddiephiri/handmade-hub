<div class="mb-8">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-slate-800 mb-2">Welcome back!</h1>
      <p class="text-slate-600">Here's what's happening across the platform today.</p>
    </div>
    <.button phx-click="refresh" class="bg-indigo-600 hover:bg-indigo-700">Refresh</.button>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
  <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
    <div class="flex items-center justify-between mb-4">
      <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" />
        </svg>
      </div>
      <span class="text-2xl font-bold text-slate-800"><%= @totals.users %></span>
    </div>
    <h3 class="text-sm font-semibold text-slate-600">Total Users</h3>
  </div>

  <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
    <div class="flex items-center justify-between mb-4">
      <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center">
        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      </div>
      <span class="text-2xl font-bold text-slate-800"><%= @totals.artisans %></span>
    </div>
    <h3 class="text-sm font-semibold text-slate-600">Artisans</h3>
  </div>

  <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
    <div class="flex items-center justify-between mb-4">
      <div class="w-12 h-12 bg-purple-100 rounded-xl flex items-center justify-center">
        <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1" />
        </svg>
      </div>
      <span class="text-2xl font-bold text-slate-800"><%= @totals.buyers %></span>
    </div>
    <h3 class="text-sm font-semibold text-slate-600">Buyers</h3>
  </div>

  <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
    <div class="flex items-center justify-between mb-4">
      <div class="w-12 h-12 bg-orange-100 rounded-xl flex items-center justify-center">
        <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
        </svg>
      </div>
      <span class="text-2xl font-bold text-slate-800"><%= @totals.products %></span>
    </div>
    <h3 class="text-sm font-semibold text-slate-600">Products</h3>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
  <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
    <p class="text-sm text-slate-500">Pending Artisan Approvals</p>
    <p class="mt-1 text-2xl font-semibold"><%= @pending_artisans %></p>
  </div>
  <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
    <p class="text-sm text-slate-500">Pending Product Approvals</p>
    <p class="mt-1 text-2xl font-semibold"><%= @pending_products %></p>
  </div>
  <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
    <p class="text-sm text-slate-500">Flagged Reviews</p>
    <p class="mt-1 text-2xl font-semibold"><%= @flagged_reviews %></p>
  </div>
</div>

<%= if @current_admin.role == "super_admin" do %>
  <div class="mb-8">
    <div class="bg-gradient-to-br from-indigo-50 to-purple-50 rounded-2xl p-6 shadow-sm border border-indigo-100">
      <div class="flex items-center justify-between">
        <div class="flex-1">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-12 h-12 bg-indigo-600 rounded-xl flex items-center justify-center">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-slate-800">Admin Management</h3>
              <p class="text-sm text-slate-600">Create and manage admin users</p>
            </div>
          </div>
          <%= if @pending_admins > 0 do %>
            <div class="mt-4 inline-flex items-center px-3 py-1.5 bg-yellow-100 text-yellow-800 rounded-full text-sm font-medium">
              <svg class="w-4 h-4 mr-1.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
              </svg>
              <%= @pending_admins %> pending approval<%= if @pending_admins > 1, do: "s", else: "" %>
            </div>
          <% end %>
        </div>
        <div>
          <.link
            navigate={~p"/admin/admins"}
            class="inline-flex items-center px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg shadow-md transition-all duration-200 hover:shadow-lg"
          >
            Manage Admins
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </.link>
        </div>
      </div>
    </div>
  </div>
<% end %>

<div class="grid grid-cols-1 xl:grid-cols-3 gap-6 mb-8">
  <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100 xl:col-span-2">
    <h3 class="font-semibold mb-4">Monthly Orders & Revenue</h3>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-gray-50 text-left">
            <th class="p-2">Month</th>
            <th class="p-2">Orders</th>
            <th class="p-2">Revenue</th>
          </tr>
        </thead>
        <tbody>
          <%= for m <- @monthly do %>
            <tr class="border-t">
              <td class="p-2"><%= m.period %></td>
              <td class="p-2"><%= m.count %></td>
              <td class="p-2"><%= HandmadeHubWeb.FormatHelpers.format_currency(m.revenue) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
    <h3 class="font-semibold mb-4">Order Status</h3>
    <ul class="space-y-2 text-sm">
      <li class="flex justify-between"><span>Pending</span><span class="font-semibold"><%= @order_stats.pending_orders %></span></li>
      <li class="flex justify-between"><span>Processing</span><span class="font-semibold"><%= @order_stats.processing_orders %></span></li>
      <li class="flex justify-between"><span>Delivered</span><span class="font-semibold"><%= @order_stats.completed_orders %></span></li>
      <li class="flex justify-between"><span>Monthly Revenue</span><span class="font-semibold"><%= HandmadeHubWeb.FormatHelpers.format_currency(@order_stats.monthly_revenue) %></span></li>
    </ul>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
    <h3 class="font-semibold mb-3">Recent Orders</h3>
    <div class="divide-y">
      <%= for o <- @recent_orders do %>
        <div class="py-2 flex justify-between text-sm">
          <div>
            <p class="font-medium">#<%= o.order_number %></p>
            <p class="text-gray-500"><%= if o.user, do: (o.user.name || o.user.email), else: (o.customer_name || o.customer_email || "—") %></p>
          </div>
          <div class="text-right">
            <p class="font-medium"><%= HandmadeHubWeb.FormatHelpers.format_currency(o.total) %></p>
            <p class="text-gray-500"><%= String.capitalize(o.status) %> • <%= String.capitalize(o.payment_status) %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
  <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-100">
    <h3 class="font-semibold mb-3">Recent Signups</h3>
    <div class="divide-y">
      <%= for u <- @recent_signups do %>
        <div class="py-2 flex justify-between text-sm">
          <div>
            <p class="font-medium"><%= u.name || u.email %></p>
            <p class="text-gray-500"><%= String.capitalize(u.role || "buyer") %></p>
          </div>
          <div class="text-right">
            <p class="text-gray-500"><%= Calendar.strftime(u.inserted_at, "%Y-%m-%d") %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
