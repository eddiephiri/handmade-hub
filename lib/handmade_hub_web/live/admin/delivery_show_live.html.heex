<div class="max-w-5xl mx-auto p-6 space-y-6">
  <div class="flex items-center justify-between">
    <.link navigate={~p"/admin/deliveries"} class="inline-flex items-center text-sm text-slate-600 hover:text-slate-900">
      <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      Back to deliveries
    </.link>
    <span class="text-xs font-medium text-slate-500">Delivery ID: DLV-<%= @delivery.id %></span>
  </div>

  <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <p class="text-sm text-slate-500">Current status</p>
        <div class="mt-2 flex items-center gap-3">
          <span class={["inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold", status_badge_class(@delivery.status)]}>
            <%= format_status(@delivery.status) %>
          </span>
          <p class="text-xs text-slate-500">
            Last updated <%= format_timestamp(@delivery.updated_at || @delivery.inserted_at) %>
          </p>
        </div>
      </div>
      <div class="text-sm text-slate-600">
        <p><span class="text-slate-400">Order:</span> <strong><%= @delivery.order && @delivery.order.order_number || "—" %></strong></p>
        <p><span class="text-slate-400">Assigned by:</span> <%= if @delivery.assigned_by_admin, do: @delivery.assigned_by_admin.username, else: "System" %></p>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6 space-y-4">
      <div>
        <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Delivery overview</p>
        <h2 class="text-lg font-semibold text-slate-900 mt-1">Assignment details</h2>
      </div>

      <dl class="space-y-3 text-sm text-slate-600">
        <div class="flex items-center justify-between">
          <dt class="text-slate-500">Order number</dt>
          <dd class="font-medium text-slate-900">
            <%= if @delivery.order, do: @delivery.order.order_number, else: "—" %>
          </dd>
        </div>
        <div class="flex items-center justify-between">
          <dt class="text-slate-500">Order total</dt>
          <dd class="font-medium text-slate-900"><%= order_total(@delivery) || "—" %></dd>
        </div>
        <div>
          <dt class="text-slate-500 mb-1">Rider</dt>
          <dd>
            <%= if @delivery.rider do %>
              <p class="font-medium text-slate-900"><%= @delivery.rider.name %></p>
              <p class="text-xs text-slate-500"><%= @delivery.rider.phone_number %> • <%= @delivery.rider.vehicle_type %></p>
            <% else %>
              <span class="text-xs text-amber-600">Unassigned</span>
            <% end %>
          </dd>
        </div>
      </dl>
    </div>

    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6 space-y-4">
      <div>
        <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Customer & Drop-off</p>
        <h2 class="text-lg font-semibold text-slate-900 mt-1">Recipient information</h2>
      </div>

      <dl class="space-y-3 text-sm text-slate-600">
        <div>
          <dt class="text-slate-500 mb-1">Customer</dt>
          <dd>
            <p class="font-medium text-slate-900"><%= customer_name(@delivery) || "—" %></p>
            <p class="text-xs text-slate-500"><%= customer_email(@delivery) || "—" %></p>
            <p class="text-xs text-slate-500"><%= customer_phone(@delivery) || "—" %></p>
          </dd>
        </div>
        <div>
          <dt class="text-slate-500 mb-1">Shipping address</dt>
          <dd class="text-slate-900"><%= @shipping && shipping_line(@shipping) || "—" %></dd>
        </div>
        <%= if @shipping && @shipping.delivery_instructions do %>
          <div>
            <dt class="text-slate-500 mb-1">Delivery instructions</dt>
            <dd class="text-slate-900"><%= @shipping.delivery_instructions %></dd>
          </div>
        <% end %>
      </dl>
    </div>
  </div>

  <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6">
    <div class="mb-4">
      <p class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Timeline</p>
      <h2 class="text-lg font-semibold text-slate-900 mt-1">Status history</h2>
    </div>

    <ol class="relative border-l border-slate-200 pl-6 space-y-6">
      <%= for step <- @timeline do %>
        <li class="relative">
          <span class="absolute -left-3 top-1.5 h-2.5 w-2.5 rounded-full bg-indigo-500"></span>
          <p class="text-sm font-semibold text-slate-900"><%= step.label %></p>
          <p class="text-xs text-slate-500"><%= format_timestamp(step.at) %></p>
          <p class="text-sm text-slate-600 mt-1"><%= step.description %></p>
        </li>
      <% end %>
    </ol>
  </div>
</div>

