<div class="min-h-screen bg-gray-50 py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-8">Shopping Cart</h1>
    
    <%= if length(@cart_items) > 0 do %>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Cart Items -->
        <div class="lg:col-span-2">
          <div class="bg-white rounded-lg shadow">
            <div class="px-6 py-4 border-b">
              <div class="flex justify-between items-center">
                <h2 class="text-lg font-semibold">Cart Items (<%= length(@cart_items) %>)</h2>
                <button 
                  phx-click="clear_cart"
                  onclick="return confirm('Are you sure you want to clear your cart?')"
                  class="text-red-600 hover:text-red-800 text-sm font-medium"
                >
                  Clear Cart
                </button>
              </div>
            </div>
            
            <div class="divide-y">
              <%= for item <- @cart_items do %>
                <div class="p-6 flex items-start space-x-4">
                  <!-- Product Image -->
                  <div class="flex-shrink-0">
                    <img 
                      src={get_product_image(item.product)} 
                      alt={item.product.name}
                      class="w-24 h-24 object-cover rounded-lg"
                    />
                  </div>
                  
                  <!-- Product Details -->
                  <div class="flex-1">
                    <h3 class="text-lg font-medium text-gray-900">
                      <.link navigate={~p"/browse/#{item.product.id}"} class="hover:text-indigo-600">
                        <%= item.product.name %>
                      </.link>
                    </h3>
                    <p class="mt-1 text-sm text-gray-500"><%= item.product.description %></p>
                    
                    <div class="mt-4 flex items-center justify-between">
                      <div class="flex items-center space-x-3">
                        <label class="text-sm text-gray-700">Qty:</label>
                        <select 
                          phx-change="update_quantity"
                          phx-value-item_id={item.id}
                          name="quantity"
                          class="border-gray-300 rounded-md text-sm"
                        >
                          <%= for qty <- 1..min(10, item.product.quantity) do %>
                            <option value={qty} selected={qty == item.quantity}>
                              <%= qty %>
                            </option>
                          <% end %>
                        </select>
                        
                        <button 
                          phx-click="remove_item"
                          phx-value-item_id={item.id}
                          class="text-red-600 hover:text-red-800 text-sm"
                        >
                          Remove
                        </button>
                      </div>
                      
                      <div class="text-right">
                        <p class="text-sm text-gray-500">K<%= item.price %> each</p>
                        <p class="text-lg font-semibold text-gray-900">
                          K<%= Decimal.mult(item.price, Decimal.new(item.quantity)) %>
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
        
        <!-- Order Summary -->
        <div class="lg:col-span-1">
          <div class="bg-white rounded-lg shadow p-6 sticky top-4">
            <h2 class="text-lg font-semibold mb-4">Order Summary</h2>
            
            <div class="space-y-3">
              <div class="flex justify-between text-sm">
                <span>Subtotal</span>
                <span>K<%= @cart_total %></span>
              </div>
              <div class="flex justify-between text-sm">
                <span>Shipping</span>
                <span class="text-gray-500">Calculated at checkout</span>
              </div>
              <div class="border-t pt-3">
                <div class="flex justify-between">
                  <span class="text-lg font-semibold">Total</span>
                  <span class="text-lg font-semibold text-indigo-600">K<%= @cart_total %></span>
                </div>
              </div>
            </div>
            
            <div class="mt-6 space-y-3">
              <button 
                phx-click="proceed_to_checkout"
                class="w-full bg-indigo-600 text-white py-3 px-4 rounded-lg hover:bg-indigo-700 font-medium"
              >
                Proceed to Checkout
              </button>
              
              <.link 
                navigate={~p"/browse"}
                class="w-full bg-gray-100 text-gray-700 py-3 px-4 rounded-lg hover:bg-gray-200 font-medium text-center block"
              >
                Continue Shopping
              </.link>
            </div>
            
            <div class="mt-6 p-4 bg-gray-50 rounded-lg">
              <p class="text-xs text-gray-600">
                <.icon name="hero-shield-check" class="w-4 h-4 inline mr-1" />
                Secure Checkout - Your information is protected
              </p>
            </div>
          </div>
        </div>
      </div>
    <% else %>
      <!-- Empty Cart -->
      <div class="bg-white rounded-lg shadow p-12 text-center">
        <.icon name="hero-shopping-cart" class="w-24 h-24 text-gray-400 mx-auto mb-4" />
        <h2 class="text-2xl font-semibold text-gray-900 mb-2">Your cart is empty</h2>
        <p class="text-gray-600 mb-6">Looks like you haven't added any items to your cart yet.</p>
        <.link 
          navigate={~p"/browse"}
          class="inline-flex items-center bg-indigo-600 text-white py-3 px-6 rounded-lg hover:bg-indigo-700 font-medium"
        >
          <.icon name="hero-arrow-left" class="w-5 h-5 mr-2" />
          Start Shopping
        </.link>
      </div>
    <% end %>
  </div>
</div>

<script>
  // Helper function to get product image
  window.getProductImage = function(product) {
    if (product.product_images && product.product_images.length > 0) {
      const primaryImage = product.product_images.find(img => img.is_primary);
      return primaryImage ? primaryImage.image_url : product.product_images[0].image_url;
    } else if (product.image) {
      return product.image;
    } else {
      return 'https://images.unsplash.com/photo-1578662996442-48f60103fc96?w=400&h=300&fit=crop';
    }
  }
</script>
